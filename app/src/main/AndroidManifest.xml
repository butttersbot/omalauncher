<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reading the newest screenshot for "Add to pocket" over the screenshot toolbar; asked for the first time it is used. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Search finds files anywhere in shared storage, by name and by their text, once he allows it (search/FileIndex.kt). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The lock and home wallpapers in the look's paper, when the owner turns that on in Style. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Never given by Android itself: the owner grants it over adb, and only LockStar's layout is asked for with it. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Samsung's own lock-screen widgets hold this; asked for in case its lock screen wants it of ours. -->
    <uses-permission android:name="com.samsung.systemui.permission.FACE_WIDGET" />
    <!-- Keeps the processor on while an agent works with the display off (assist/StayAwake.kt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 17+: widgets and Linux reaching 192.168.x and other local addresses. Asked for
         from a row in settings (LocalNetwork.kt). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the agent's progress notification ask to be a Live Update (Android 16 QPR1 and later). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Speech input for the agent prompt bar; only recognized text reaches Linux. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Uninstall from the app drawer's long-press menu (ACTION_DELETE). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Whether a VPN is up, before Tailscale is asked to connect (assist/TailscaleHeal.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <queries>
        <!-- LockStar's share provider, for the lock-screen layout; see theme/LockStarShare.kt. -->
        <package android:name="com.samsung.systemui.lockstar" />
        <!-- Tailscale, named so the heal can see it is installed and reach its receiver whatever its launcher entry. -->
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets SpeechRecognizer find the phone's recognition service. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:theme="@style/Theme.Omalauncher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A widget shared as a link or QR code: https://simonschubert.github.io/omarchy-widgets/w#owl1.<data> (widgets/market/Share.kt). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="simonschubert.github.io" android:pathPrefix="/omarchy-widgets/w" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LinuxWindowActivity"
            android:label="Linux"
            android:theme="@style/Theme.Omalauncher.Window"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:documentLaunchMode="always"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />

        <!-- Recents names a task after its activity's manifest label, so the common windows get their own. -->
        <activity-alias
            android:name=".TerminalWindow"
            android:exported="false"
            android:label="Terminal"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".BtopWindow"
            android:exported="false"
            android:label="btop"
            android:targetActivity=".LinuxWindowActivity" />

        <!-- And each coding agent (Agent.windowAlias), with its logo: Recents shows the activity's icon too. -->
        <activity-alias
            android:name=".ClaudeWindow"
            android:exported="false"
            android:icon="@drawable/agent_claude"
            android:label="Claude Code"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".OpencodeWindow"
            android:exported="false"
            android:icon="@drawable/agent_opencode"
            android:label="OpenCode"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CodexWindow"
            android:exported="false"
            android:icon="@drawable/agent_codex"
            android:label="Codex"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".GrokWindow"
            android:exported="false"
            android:icon="@drawable/agent_grok"
            android:label="Grok"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CopilotWindow"
            android:exported="false"
            android:icon="@drawable/agent_copilot"
            android:label="GitHub Copilot"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CrushWindow"
            android:exported="false"
            android:icon="@drawable/agent_crush"
            android:label="Crush"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CursorAgentWindow"
            android:exported="false"
            android:icon="@drawable/agent_cursor_agent"
            android:label="Cursor CLI"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".AgyWindow"
            android:exported="false"
            android:icon="@drawable/agent_agy"
            android:label="Antigravity"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".PiWindow"
            android:exported="false"
            android:icon="@drawable/agent_pi"
            android:label="Pi"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".OmpWindow"
            android:exported="false"
            android:icon="@drawable/agent_omp"
            android:label="Oh My Pi"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".OriWindow"
            android:exported="false"
            android:icon="@drawable/agent_ori"
            android:label="Ori"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".MuseWindow"
            android:exported="false"
            android:icon="@drawable/agent_muse"
            android:label="Muse Code"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".KimiWindow"
            android:exported="false"
            android:icon="@drawable/agent_kimi"
            android:label="Kimi"
            android:targetActivity=".LinuxWindowActivity" />

        <!-- Asks before an app pins a shortcut to home (ShortcutManager.requestPinShortcut); browsers only install
             websites when the home app has this. Its own task, so the system's CLEAR_TASK never touches home's,
             gone once left. Not exported: the system starts it, and other apps have no reason to. -->
        <activity
            android:name=".PinShortcutActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Omalauncher.Dialog">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- One task per owl app, named after it; launched with its file name in the intent's data. -->
        <activity
            android:name=".OwlAppActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:label="App"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize" />

        <!-- One task per file, named after it; launched with the file in the intent's data. -->
        <activity
            android:name=".EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:icon="@drawable/editor"
            android:label="Editor"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FilesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:icon="@drawable/files"
            android:label="Files"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.files"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".phone.PhoneControlActivity" android:exported="true" android:label="Phone control${labelSuffix}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".phone.StopPhoneControl" android:exported="false" />
        <!-- The debug door: does nothing in a release build, and in a debug one only for the key in the app's own files. -->
        <receiver android:name=".DebugExecReceiver" android:exported="true" />
        <!-- The newest screenshot into the pocket, for the button over Samsung's screenshot toolbar (herd/Pocket.kt). -->
        <activity android:name=".herd.PocketShotActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="" />
        <!-- "Add to pocket" in the share sheet: what is shared goes into the herd's pocket (herd/Pocket.kt). Shows nothing. -->
        <activity android:name=".herd.PocketShareActivity" android:exported="true" android:label="Add to pocket"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- "Add to a panel" in the share sheet: one picture or GIF into a manga panel (art/ArtActivities.kt). Shows nothing. -->
        <!-- Not noHistory: it finishes itself once the copy is done, and finishing early would take back the grant to read it. -->
        <activity android:name=".art.ArtShareActivity" android:exported="true" android:label="Add to a panel"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- The photo picker for an empty manga panel, opened by home (art/ArtActivities.kt). Only the picker shows. -->
        <activity android:name=".art.ArtPickActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" />
        <!-- What Tailshare received, for the sheep's "Sent to this phone": only Tailshare is heard (herd/ClipInbox.kt). -->
        <receiver android:name=".herd.ClipReceivedReceiver" android:exported="true">
            <intent-filter><action android:name="dev.omalauncher.action.CLIP_RECEIVED" /></intent-filter>
        </receiver>
        <!-- Agent mail that came by Taildrop, handed over by Tailshare: only Tailshare is heard (assist/AgentMail.kt). -->
        <receiver android:name=".assist.AgentMailReceiver" android:exported="true">
            <intent-filter><action android:name="dev.omalauncher.action.AGENT_MESSAGE" /></intent-filter>
        </receiver>
        <!-- Another app's "sent" note, drawn in the look: only the apps in phone/OmaToast.kt's list are heard. -->
        <receiver android:name=".phone.OmaToastReceiver" android:exported="true">
            <intent-filter><action android:name="dev.omalauncher.action.TOAST" /></intent-filter>
        </receiver>
        <!-- The GPU for the phone's photo-search model (LiteRT-LM); without it, its CPU. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <service android:name=".phone.PhoneService" android:exported="true"
            android:label="${appLabel} phone control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/phone_accessibility" />
        </service>

        <!-- The herd sheep on and off (assist/OmaTiles.kt). -->
        <service android:name=".assist.HerdSheepTile" android:exported="true"
            android:label="Herd sheep" android:icon="@drawable/ic_oma_prompt_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".assist.OmaPromptTile" android:exported="true"
            android:label="Soma prompt" android:icon="@drawable/ic_oma_prompt_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <service android:name=".assist.OmaActivityTile" android:exported="true"
            android:label="Agent activity" android:icon="@drawable/ic_oma_activity_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <service android:name=".assist.OmaApprovalsTile" android:exported="true"
            android:label="Soma approvals" android:icon="@drawable/ic_oma_approval_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <!-- The Oma app: the agent's thread, typed messages and image attachments. Opened inside the app by its action. -->
        <activity
            android:name=".oma.OmaChatActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:label="Soma"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.oma"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="dev.omalauncher.action.OMA_CHAT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Holds no data: it runs first in the process, to know when one of the app's own screens is showing. -->
        <provider
            android:name=".oma.OmaStartup"
            android:authorities="${applicationId}.oma-startup"
            android:exported="false" />

        <!-- The Oma chat's place in the app list, now that the dock has no button for it. -->
        <activity-alias
            android:name=".oma.OmaChatEntry"
            android:exported="true"
            android:label="Soma${labelSuffix}"
            android:targetActivity=".oma.OmaChatActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".assist.AgentApprovalActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.Dialog.NoActionBar" />
        <activity android:name=".assist.AssistantPromptActivity" android:exported="true"
            android:label="Soma agent" android:theme="@android:style/Theme.Material.Dialog.NoActionBar"
            android:excludeFromRecents="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".assist.AssistantSetupActivity" android:exported="true" android:label="Soma assistant${labelSuffix}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".assist.StopAgentTask" android:exported="false" />
        <!-- Oma's state as a widget: the standard declaration, and the one Samsung's lock screen reads from its own apps. -->
        <receiver android:name=".assist.OmaLockWidget" android:exported="true" android:label="Soma status${labelSuffix}">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/oma_lock_widget" />
            <meta-data android:name="samsung.appwidget.monotone.info" android:resource="@xml/oma_lock_widget_monotone" />
        </receiver>
        <receiver android:name=".assist.OmaClockWidget" android:exported="true" android:label="Soma clock${labelSuffix}">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/oma_clock_widget" />
        </receiver>
        <receiver android:name=".assist.OmaWatchWidget" android:exported="true" android:label="Soma watchlist${labelSuffix}">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/oma_watch_widget" />
        </receiver>
        <!-- Approve once / Deny on an approval notification; only this app's own PendingIntents reach it. -->
        <receiver android:name=".assist.ApprovalActionReceiver" android:exported="false" />
        <!-- The same two buttons for a request of a project thread on the Mac; only this app's own PendingIntents reach it. -->
        <receiver android:name=".assist.MacApprovalReceiver" android:exported="false" />
        <service android:name=".assist.OmaVoiceService" android:exported="true"
            android:label="Soma agent" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/oma_voice_interaction" />
        </service>
        <service android:name=".assist.OmaRecognitionService" android:exported="true"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <service android:name=".assist.OmaSessionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- The Oma keyboard: Apple's layout in Oma's look (keyboard/). Boss switches it on in Android's settings himself. -->
        <service android:name=".keyboard.OmaKeyboardService" android:exported="true"
            android:label="Soma keyboard${labelSuffix}" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/oma_keyboard" />
        </service>
        <activity android:name=".keyboard.KeyboardSettingsActivity" android:exported="true"
            android:label="Soma keyboard${labelSuffix}" android:windowSoftInputMode="stateHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".theme.OmarchyWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Notification access lets widgets show and control what's playing (android.media) and list notifications (android.notifications). -->
        <service
            android:name=".widgets.runtime.MediaListener"
            android:exported="true"
            android:label="Soma widgets"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Keeps search's file index, in a process of its own that ends with each run (search/FileIndex.kt). -->
        <service
            android:name=".search.FileIndexJob"
            android:exported="false"
            android:process=":indexer"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Reads a photo search's words with the phone's own model when the Mac Pro is away (search/PhotoText.kt). -->
        <service
            android:name=".search.PhotoTextService"
            android:exported="false"
            android:process=":indexer" />
        <!-- Sends new photos to the Mac Pro to be read for search, and keeps what comes back (search/PhotoIndex.kt). -->
        <service
            android:name=".search.PhotoIndexJob"
            android:exported="false"
            android:process=":indexer"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".LinuxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started Linux environment and its display server" />
        </service>
    </application>
</manifest>
