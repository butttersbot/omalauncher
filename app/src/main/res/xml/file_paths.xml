<?xml version="1.0" encoding="utf-8"?>
<!-- Files hands guest files to Android apps ("open with", "share"); the rootfs lives in files/arch,
     and proot binds /tmp, the runtime dir and the launcher's own data (LauncherData) from beside it. -->
<paths>
    <files-path name="guest" path="arch/" />
    <files-path name="tmp" path="tmp/" />
    <files-path name="xdg" path="xdg/" />
    <files-path name="omarchy" path="omarchy/" />
    <files-path name="widgets" path="widgets/" />
    <!-- QR codes of widgets, for sharing as an image. -->
    <cache-path name="share" path="share/" />
    <!-- Pocket items pulled from the Mac Pro, to open or copy (herd/Pocket.kt). -->
    <cache-path name="pocket" path="pocket/" />
    <!-- GIFs the keyboard places in an app's message box (keyboard/GifPanel.kt). -->
    <cache-path name="gifs" path="gifs/sent/" />
    <!-- What Tailshare received, kept for "Sent to this phone" (herd/ClipInbox.kt). -->
    <files-path name="inbox" path="inbox/" />
    <!-- Files search found in shared storage, opened or shared from the search card. -->
    <external-path name="storage" path="." />
</paths>
