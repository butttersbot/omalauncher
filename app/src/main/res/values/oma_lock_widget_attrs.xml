<?xml version="1.0" encoding="utf-8"?>
<!--
  The names Samsung's lock screen reads from a widget's `samsung.appwidget.monotone.info` file, as its own apps
  declare them (read off the Routines app on One UI 9). They are not in any SDK: declared here so the file compiles.
-->
<resources>
    <attr name="monotoneInitialLayoutMedium" format="reference" />
    <attr name="monotoneInitialLayoutSmall" format="reference" />
    <attr name="monotoneInitialLayoutTiny" format="reference" />
    <attr name="monotonePreviewLayoutMedium" format="reference" />
    <attr name="monotonePreviewLayoutSmall" format="reference" />
    <attr name="monotonePreviewLayoutTiny" format="reference" />
    <attr name="targetHost" format="integer" />
    <attr name="widgetSize" format="integer" />
    <attr name="widgetStyle" format="integer" />
</resources>
