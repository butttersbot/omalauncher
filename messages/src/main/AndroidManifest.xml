<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pages and videos open in the side panel beside the chat. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- OpenBubbles does the iMessage work; this app opens its conversations, so it has to be able to see it. -->
    <queries>
        <package android:name="com.openbubbles.messaging" />
    </queries>

    <application
        android:label="Soma Messages"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Photos go to OpenBubbles' conversation as copies it may read once, from the cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.omalauncher.messages.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_photos" />
        </provider>

        <!-- Reads OpenBubbles' message notifications and answers through their Reply action. Android asks the owner
             before it binds, in its notification access settings. -->
        <service
            android:name=".engine.OpenBubblesListener"
            android:exported="true"
            android:label="Soma Messages"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
