def install():
    target = HOME / '.local/bin/grok-cloud'
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(__file__, target)
    os.chmod(target, 0o755)
    plist = HOME / 'Library/LaunchAgents/dev.omalauncher.grok-cloud.plist'
    plist.write_text(PLIST % (sys.executable, target, HOME, HOME, HOME))
    uid = str(os.getuid())
    subprocess.run(['launchctl', 'bootout', 'gui/' + uid, str(plist)], capture_output=True)
    subprocess.run(['launchctl', 'bootstrap', 'gui/' + uid, str(plist)], check=True)
    print('installed %s, running under launchd (dev.omalauncher.grok-cloud)' % target)


