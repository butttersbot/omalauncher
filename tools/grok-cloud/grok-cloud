from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get('GROK_CLOUD_STATE', HOME / '.local/share/soma/grok-cloud'))
JOBS = STATE / 'jobs'
CONFIG = Path(os.environ.get('GROK_CLOUD_CONFIG', HOME / '.config/soma/grok-cloud.json'))
MADE = Path(os.environ.get('GROK_CLOUD_MADE', HOME / 'Soma/made'))
PUBLIC = os.environ.get('GROK_CLOUD_PUBLIC', 'https://jacks-mac-pro.tail56d7f9.ts.net')
POCKET = os.environ.get('GROK_CLOUD_POCKET', 'http://100.120.219.46:8480/v1/pocket')
JOB_PORT = int(os.environ.get('GROK_CLOUD_JOB_PORT', '8493'))
CB_PORT = int(os.environ.get('GROK_CLOUD_CB_PORT', '8494'))
KEYCHAIN = 'soma-grok-webhook'

TOOLS = {'midjourney': ('image', 'video'), 'suno': ('song',)}
JOBS_PER_HOUR = 10
JOBS_PER_DAY = 30
MAX_PROMPT = 2000
MAX_FILES = 8
MAX_FILE_BYTES = 300 << 20          # a short video, downloaded to disk in pieces
MAX_UPLOAD_BYTES = 40 << 20         # an uploaded result is read into memory to be parsed: kept small
MAX_JSON_BYTES = 64 << 10           # a result with links
JOB_LIFETIME = 6 * 3600             # no answer by then: expired, its token dead
# The only file types kept, each with the one extension it's saved under: never the sender's file name.
MEDIA = {
    'image/png': '.png', 'image/jpeg': '.jpg', 'image/webp': '.webp', 'image/gif': '.gif',
    'video/mp4': '.mp4', 'video/webm': '.webm', 'video/quicktime': '.mov',
    'audio/mpeg': '.mp3', 'audio/mp4': '.m4a', 'audio/x-m4a': '.m4a', 'audio/wav': '.wav', 'audio/x-wav': '.wav',
    'audio/wave': '.wav', 'audio/ogg': '.ogg', 'audio/flac': '.flac',
}
# What a file's first bytes say it is, for one sent without a type or as application/octet-stream.
MAGIC = [
    (b'\x89PNG\r\n\x1a\n', 'image/png'), (b'\xff\xd8\xff', 'image/jpeg'), (b'GIF8', 'image/gif'),
    (b'ID3', 'audio/mpeg'), (b'\xff\xfb', 'audio/mpeg'), (b'\xff\xf3', 'audio/mpeg'), (b'OggS', 'audio/ogg'),
    (b'fLaC', 'audio/flac'), (b'\x1aE\xdf\xa3', 'video/webm'),
]
ID = re.compile(r'^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$')

lock = threading.Lock()


def log(*words):
    print('grok-cloud:', *words, flush=True)


# ---------- jobs on disk ----------

def job_path(job_id):
    return JOBS / (job_id + '.json')


def load(job_id):
    if not ID.match(job_id or ''):
        return None
    try:
        return json.loads(job_path(job_id).read_text())
    except (OSError, ValueError):
        return None


def save(job):
    JOBS.mkdir(parents=True, exist_ok=True)
    tmp = job_path(job['job']).with_suffix('.tmp')
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(job, f, indent=1)
    os.replace(tmp, job_path(job['job']))


def all_jobs():
    out = []
    for p in sorted(JOBS.glob('*.json')):
        try:
            out.append(json.loads(p.read_text()))
        except (OSError, ValueError):
            pass
    return out


def public(job):
    """A job as an agent may see it: never its token."""
    return {k: v for k, v in job.items() if k != 'token'}


def expire_old(now=None):
    """Marks jobs with no answer in time as expired; returns them, for [notify] after the lock is let go."""
    now = now or time.time()
    gone = []
    for job in all_jobs():
        if job.get('status') in ('sent', 'working') and now - job.get('created', now) > JOB_LIFETIME:
            job['status'], job['token'] = 'expired', None
            job['message'] = 'no answer from Grok within %d hours' % (JOB_LIFETIME // 3600)
            save(job)
            gone.append(job)
    return gone


def notify_all(jobs):
    for job in jobs:
        notify(job)


def under_caps(now=None):
    now = now or time.time()
    created = [j.get('created', 0) for j in all_jobs()]
    hour = sum(1 for t in created if now - t < 3600)
    day = sum(1 for t in created if now - t < 86400)
    if hour >= JOBS_PER_HOUR:
        return 'at most %d jobs an hour; try again later' % JOBS_PER_HOUR
    if day >= JOBS_PER_DAY:
        return 'at most %d jobs a day; try again tomorrow' % JOBS_PER_DAY
    return None


# ---------- who's asking ----------

class Owner:
    def __init__(self):
        self.login = None
        self.known = {}

    def who(self, address):
        """(owner's device?, device name), from `tailscale whois`; what a request claims doesn't count."""
        if address in ('127.0.0.1', '::1') and os.environ.get('GROK_CLOUD_TRUST_LOOPBACK') == '1':
            return True, 'test'
        hit = self.known.get(address)
        if hit and time.time() - hit[2] < 600:
            return hit[:2]
        ok, device = False, None
        try:
            if not self.login:
                st = json.loads(run(['tailscale', 'status', '--json']))
                self.login = st['User'][str(st['Self']['UserID'])]['LoginName']
            who = json.loads(run(['tailscale', 'whois', '--json', address]))
            ok = (who.get('UserProfile') or {}).get('LoginName') == self.login
            node = who.get('Node') or {}
            device = (node.get('Name') or '').split('.')[0] or node.get('ComputedName')
        except Exception as problem:  # noqa: BLE001 - any failure means "not known to be his"
            log('could not check', address, problem)
        self.known[address] = (ok, device, time.time())
        return ok, device


def run(argv, timeout=20):
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=True).stdout


# ---------- sending a job to Grok ----------

def keychain(account):
    try:
        return run(['security', 'find-generic-password', '-s', KEYCHAIN, '-a', account, '-w']).strip()
    except Exception:  # noqa: BLE001
        return None


def config():
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Redirects aren't followed: a link or the webhook could otherwise send a request, or the key, elsewhere."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, 'redirects are not followed', headers, fp)


opener = urllib.request.build_opener(NoRedirect)


def public_host(url):
    """Whether [url]'s host resolves only to public internet addresses: not this Mac, the LAN or the tailnet."""
    host = urllib.parse.urlparse(url).hostname
    if not host:
        return False
    try:
        addresses = {info[4][0] for info in socket.getaddrinfo(host, 443, proto=socket.IPPROTO_TCP)}
    except OSError:
        return False
    tailnet = [ipaddress.ip_network('100.64.0.0/10'), ipaddress.ip_network('fd7a:115c:a1e0::/48')]
    for a in addresses:
        ip = ipaddress.ip_address(a.split('%')[0])
        if not ip.is_global or any(ip in net for net in tailnet):
            return False
    return bool(addresses)


def send_to_grok(job):
    url, key = keychain('url'), keychain('key')
    cfg = config()
    header = cfg.get('key_header')
    if not url or not key or not header:
        return 'the Grok webhook isn\'t set up yet (Keychain soma-grok-webhook url/key, and key_header in %s)' % CONFIG
    if not url.startswith('https://'):
        return 'the Grok webhook URL must be https'
    if not public_host(url):
        return 'the Grok webhook URL must be a public internet host'
    body = json.dumps({
        'job': job['job'], 'tool': job['tool'], 'kind': job['kind'], 'prompt': job['prompt'],
        'callback_url': '%s/grok/cb/%s/%s' % (PUBLIC, job['job'], job['token']),
    }).encode()
    request = urllib.request.Request(url, data=body, method='POST', headers={
        'Content-Type': 'application/json', header: cfg.get('key_prefix', '') + key})
    try:
        with opener.open(request, timeout=30) as answer:
            if not 200 <= answer.status < 300:
                return 'Grok\'s webhook answered %d' % answer.status
    except urllib.error.HTTPError as e:
        return 'Grok\'s webhook answered %d' % e.code
    except (urllib.error.URLError, OSError) as e:
        return 'couldn\'t reach Grok\'s webhook: %s' % getattr(e, 'reason', e)
    return None


def new_job(tool, kind, prompt, device, session):
    now = time.time()
    job = {
        'job': time.strftime('%Y%m%d-%H%M%S', time.localtime(now)) + '-' + secrets.token_hex(3),
        'token': secrets.token_urlsafe(32),
        'tool': tool, 'kind': kind, 'prompt': prompt,
        'from': device, 'session': session, 'created': now, 'status': 'sent', 'message': '', 'files': [],
    }
    return job


# ---------- results from Grok ----------

def media_type(ctype, head):
    """The file's type if it's one we keep, from its declared type or else its first bytes; never its name."""
    kind = (ctype or '').split(';')[0].strip().lower()
    if kind in MEDIA:
        return kind
    if kind in ('', 'application/octet-stream', 'binary/octet-stream'):
        for magic, sniffed in MAGIC:
            if head.startswith(magic):
                return sniffed
        if head[4:8] == b'ftyp':
            return 'video/mp4'
        if head[:4] == b'RIFF' and head[8:12] == b'WAVE':
            return 'audio/wav'
        if head[:4] == b'RIFF' and head[8:12] == b'WEBP':
            return 'image/webp'
    return None


def download(link, dest):
    """A file Grok links to, into [dest] in pieces: https to a public host only, no redirects, capped in size and
    time. Returns its declared content type."""
    if not isinstance(link, str) or not link.startswith('https://'):
        raise ValueError('not an https link')
    if not public_host(link):
        raise ValueError('not a public internet host')
    request = urllib.request.Request(link, headers={'User-Agent': 'soma-grok-cloud'})
    with opener.open(request, timeout=120) as answer, open(dest, 'wb') as out:
        if int(answer.headers.get('Content-Length') or 0) > MAX_FILE_BYTES:
            raise ValueError('larger than %d MB' % (MAX_FILE_BYTES >> 20))
        total = 0
        while True:
            piece = answer.read(1 << 20)
            if not piece:
                break
            total += len(piece)
            if total > MAX_FILE_BYTES:
                raise ValueError('larger than %d MB' % (MAX_FILE_BYTES >> 20))
            out.write(piece)
        return answer.headers.get('Content-Type', '')


def keep(job, src, ctype):
    """Keeps the file at [src] (a temporary file) for [job] if it's media: moved into MADE, then sent to the Pocket."""
    with open(src, 'rb') as f:
        head = f.read(16)
    kind = media_type(ctype, head)
    if not kind:
        raise ValueError('not an image, video or audio file we keep (%s)' % ((ctype or 'no type').split(';')[0][:40]))
    day = MADE / time.strftime('%Y-%m-%d')
    day.mkdir(parents=True, exist_ok=True)
    path = day / ('%s-%s-%d%s' % (job['job'], job['tool'], len(job['files']) + 1, MEDIA[kind]))
    shutil.move(src, path)
    os.chmod(path, 0o644)
    job['files'].append(str(path))
    try:
        with open(path, 'rb') as f:
            request = urllib.request.Request(POCKET + '?name=' + urllib.parse.quote(path.name), data=f, method='POST',
                                             headers={'Content-Type': kind, 'Content-Length': str(path.stat().st_size)})
            urllib.request.urlopen(request, timeout=120).read()
    except Exception as e:  # noqa: BLE001 - the file is kept either way
        log('pocket upload failed for', path.name, e)


def scratch():
    STATE.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=STATE, prefix='incoming-')
    os.close(fd)
    return name


def finish(job, payload, parts):
    """Takes Grok's answer for [job]: its files, uploaded or downloaded, then says so to whoever asked."""
    status = payload.get('status') if payload.get('status') in ('done', 'failed', 'blocked') else 'failed'
    message = str(payload.get('message') or '')[:500]
    problems = []
    for data, ctype, _name in parts[:MAX_FILES]:
        tmp = scratch()
        try:
            with open(tmp, 'wb') as f:
                f.write(data)
            keep(job, tmp, ctype)
        except Exception as e:  # noqa: BLE001 - one bad file doesn't stop the rest
            problems.append(str(e)[:200])
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    links = payload.get('files') or []
    for link in (links if isinstance(links, list) else [])[:max(0, MAX_FILES - len(job['files']))]:
        tmp = scratch()
        try:
            keep(job, tmp, download(link, tmp))
        except Exception as e:  # noqa: BLE001
            problems.append('%s: %s' % (str(link)[:80], str(e)[:200]))
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    if status == 'done' and not job['files']:
        status = 'failed'
        problems.insert(0, 'Grok said done but no file came')
    job['status'] = status
    job['message'] = '; '.join(filter(None, [message] + problems))[:800]
    job['finished'] = time.time()
    save(job)
    notify(job)


def notify(job):
    who = job.get('from')
    if not who or who == 'test':
        return
    target = who + (':' + job['session'] if job.get('session') else '')
    files = '\n'.join(job.get('files') or [])
    text = 'Grok cloud job %s (%s %s): %s. %s%s' % (
        job['job'], job['tool'], job['kind'], job['status'], job.get('message') or '',
        ('\nFiles (also in the Pocket):\n' + files) if files else '')
    try:
        subprocess.run(['tmsg', 'send', target, '--title', 'Soma grok-cloud', text], timeout=60,
                       capture_output=True, check=False)
    except Exception as e:  # noqa: BLE001
        log('couldn\'t mail', target, e)


def parse_multipart(ctype, body):
    message = email.parser.BytesParser(policy=email.policy.HTTP).parsebytes(
        b'Content-Type: ' + ctype.encode() + b'\r\n\r\n' + body)
    fields, files = {}, []
    for part in message.iter_parts():
        name = part.get_param('name', header='content-disposition')
        filename = part.get_filename()
        data = part.get_payload(decode=True) or b''
        if filename or name == 'file':
            files.append((data, part.get_content_type(), filename or ''))
        elif name:
            fields[name] = data.decode('utf-8', 'replace')
    return fields, files


# ---------- HTTP ----------

class Quiet(http.server.BaseHTTPRequestHandler):
    server_version = 'soma'
    sys_version = ''
    timeout = 30   # a connection that sends nothing for this long is closed: no thread held by a slow client

    def log_message(self, *args):
        pass

    def reply(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def body(self, limit):
        size = int(self.headers.get('Content-Length') or -1)
        if size < 0 or size > limit:
            return None
        return self.rfile.read(size)


class Jobs(Quiet):
    owner = Owner()

    def allowed(self):
        ok, device = self.owner.who(self.client_address[0])
        if not ok:
            self.reply(403, {'error': 'only Boss\'s devices'})
        return ok, device

    def do_GET(self):
        ok, _ = self.allowed()
        if not ok:
            return
        parts = self.path.split('?')[0].strip('/').split('/')
        with lock:
            gone = expire_old()
            jobs = all_jobs()[-20:] if parts == ['v1', 'jobs'] else None
            job = load(parts[2]) if len(parts) == 3 and parts[:2] == ['v1', 'jobs'] else None
        notify_all(gone)
        if jobs is not None:
            return self.reply(200, {'jobs': [public(j) for j in jobs]})
        if job:
            return self.reply(200, public(job))
        self.reply(404, {'error': 'no such job' if len(parts) == 3 else 'not here'})

    def do_POST(self):
        ok, device = self.allowed()
        if not ok:
            return
        if self.path.split('?')[0].rstrip('/') != '/v1/jobs':
            return self.reply(404, {'error': 'not here'})
        raw = self.body(64 << 10)
        try:
            ask = json.loads(raw or b'')
        except ValueError:
            return self.reply(400, {'error': 'send JSON'})
        tool, kind = ask.get('tool'), ask.get('kind') or None
        prompt = str(ask.get('prompt') or '').strip()
        session = re.sub(r'[^0-9A-Za-z-]', '', str(ask.get('session') or ''))[:64] or None
        if tool not in TOOLS:
            return self.reply(400, {'error': 'tool is midjourney or suno'})
        kind = kind or TOOLS[tool][0]
        if kind not in TOOLS[tool]:
            return self.reply(400, {'error': '%s makes %s' % (tool, ' or '.join(TOOLS[tool]))})
        if not prompt or len(prompt) > MAX_PROMPT:
            return self.reply(400, {'error': 'a prompt of 1 to %d characters' % MAX_PROMPT})
        with lock:
            gone = expire_old()
            full = under_caps()
            if not full:
                job = new_job(tool, kind, prompt, device, session)
                problem = send_to_grok(job)
                if problem:
                    job['status'], job['message'], job['token'] = 'failed', problem, None
                save(job)
        notify_all(gone)
        if full:
            return self.reply(429, {'error': full})
        log('job', job['job'], tool, kind, 'from', device, job['status'])
        self.reply(200 if not problem else 502, public(job))


class Results(Quiet):
    def do_GET(self):
        self.reply(404, {})

    def valid(self, job_id, token):
        job = load(job_id)
        return job if (job and job.get('token') and job.get('status') == 'sent'
                       and time.time() - job.get('created', 0) <= JOB_LIFETIME
                       and hmac.compare_digest(job['token'], token)) else None

    def do_POST(self):
        m = re.search(r'/cb/([0-9]{8}-[0-9]{6}-[0-9a-f]{6})/([A-Za-z0-9_-]{20,})/?$', self.path.split('?')[0])
        if not m:
            return self.reply(404, {})
        job_id, token = m.groups()
        with lock:
            if not self.valid(job_id, token):
                return self.reply(404, {})
        ctype = self.headers.get('Content-Type', '')
        multipart = ctype.startswith('multipart/form-data')
        raw = self.body(MAX_UPLOAD_BYTES if multipart else MAX_JSON_BYTES)
        if raw is None:
            return self.reply(413, {'error': 'too large: send links for files over %d MB' % (MAX_UPLOAD_BYTES >> 20)})
        try:
            if multipart:
                fields, parts = parse_multipart(ctype, raw)
                files = fields.get('files')
                payload = {'status': fields.get('status'), 'message': fields.get('message'),
                           'files': json.loads(files) if files else []}
            else:
                payload, parts = json.loads(raw or b'{}'), []
                if not isinstance(payload, dict):
                    raise ValueError
        except ValueError:
            return self.reply(400, {'error': 'JSON or multipart, please'})
        del raw
        # Claimed once, under the lock: the token stops working here, so a second answer (a retry, a copy) is refused.
        with lock:
            job = self.valid(job_id, token)
            if not job:
                return self.reply(404, {})
            job['status'], job['token'] = 'working', None
            save(job)
        self.reply(200, {'ok': True})
        threading.Thread(target=settle, args=(job_id, payload, parts), daemon=True).start()


def settle(job_id, payload, parts):
    """Finishes a claimed job; whatever goes wrong, it ends failed and the asker hears, never left working."""
    job = load(job_id)
    if not job:
        return
    try:
        finish(job, payload, parts)
        log('job', job_id, 'finished', job['status'], len(job['files']), 'files')
    except Exception as e:  # noqa: BLE001
        job['status'], job['message'], job['finished'] = 'failed', 'couldn\'t keep the result: %s' % str(e)[:200], time.time()
        save(job)
        notify(job)
        log('job', job_id, 'failed while keeping its result:', e)


class Threaded(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


def serve():
    JOBS.mkdir(parents=True, exist_ok=True)
    tailnet = os.environ.get('GROK_CLOUD_JOB_BIND') or run(['tailscale', 'ip', '-4']).strip().splitlines()[0]
    jobs = Threaded((tailnet, JOB_PORT), Jobs)
    results = Threaded(('127.0.0.1', CB_PORT), Results)
    threading.Thread(target=results.serve_forever, daemon=True).start()
    log('jobs on %s:%d (tailnet), results on 127.0.0.1:%d (Funnel /grok/cb)' % (tailnet, JOB_PORT, CB_PORT))
    jobs.serve_forever()


