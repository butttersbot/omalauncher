# What an agent says when it cannot take more work right now: its plan's usage, a rate or concurrency limit, or an
# overloaded service. Matched only on errors (a failed result, an error event, or what a dead agent left on stderr),
# never on ordinary text, so a turn that merely talks about rate limits is not taken for one.
LIMIT = re.compile(r'usage limit|hit your (\w+ )?limit|limit (reached|exceeded)|rate.?limit|out of (extra )?usage|'
                   r'too many (concurrent|requests)|concurren\w* (session )?limit|overloaded', re.I)
