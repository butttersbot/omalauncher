HELP_LINES = __doc__.split('\n\n')[1]


def fail(text, code=2):
    sys.stderr.write('soma-artifact: ' + text + '\n')
    sys.exit(code)


def options(words, allowed):
    found, rest = {}, []
    while words:
        word = words.pop(0)
        if word in ('-h', '--help'):
            print(__doc__)
            sys.exit(0)
        if word.startswith('--') and '=' in word:
            word, value = word.split('=', 1)
            words.insert(0, value)
        if word in allowed:
            if not words:
                fail(word + ' needs a value\n' + HELP_LINES)
            found[word[2:]] = words.pop(0)
        elif word.startswith('--'):
            fail('unknown option ' + word + '\n' + HELP_LINES)
        else:
            rest.append(word)
    return found, rest


def ask(request):
    where, token, thread = os.environ.get('SOMA_ARTIFACT_SOCKET'), os.environ.get('SOMA_ARTIFACT_TOKEN'), os.environ.get('SOMA_THREAD')
    if not where or not token or not thread:
        fail('this shell is not a Soma conversation (no SOMA_THREAD); only an agent Soma runs can show artifacts.')
    link = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    link.settimeout(30)
    try:
        link.connect(where)
        link.sendall(json.dumps({**request, 'thread': thread, 'token': token}).encode() + b'\n')
        link.shutdown(socket.SHUT_WR)
        answer = b''
        while len(answer) < 4 * 1024 * 1024:
            part = link.recv(65536)
            if not part:
                break
            answer += part
    except OSError as problem:
        fail('Soma\'s runner could not be reached (%s). It may be restarting; try again in a moment.' % problem, 1)
    finally:
        link.close()
    try:
        answer = json.loads(answer)
    except ValueError:
        fail('the runner gave an answer that could not be read.', 1)
    if not answer.get('ok'):
        fail(str(answer.get('error') or 'the runner said no.'), 1)
    return answer


