# The update pill's hold (POST /update/hold): until this time no new turn starts here and agent mail waits in new/.
UPDATE_HOLD = {'until': 0.0}
UPDATE_HOLD_MOST = 600


def update_held():
    return time.time() < UPDATE_HOLD['until']


def update_busy():
    """The threads with any work an update's restart would cut off, by name (as runner_work counts it)."""
    with changed:
        busy = []
        for thread in threads.values():
            kept = getattr(thread, 'kept', None)
            if (thread.meta.get('status') in ('working', 'waiting') or thread.pending or thread.queue
                    or (kept is not None and not kept.done and kept.driver.background)):
                busy.append(thread.meta.get('name') or thread.meta['id'])
        return busy


def runner_work():
    """Every kind of runner work the owner-approved service restart must wait for (soma_services.WorkGate)."""
    with changed:
        counts = {'working': 0, 'waiting': 0, 'queued': 0, 'background': 0}
        for thread in threads.values():
            counts['working'] += thread.meta.get('status') == 'working'
            counts['waiting'] += thread.meta.get('status') == 'waiting' or bool(thread.pending)
            counts['queued'] += len(thread.queue)
            kept = getattr(thread, 'kept', None)
            if kept is not None and not kept.done:
                counts['background'] += len(kept.driver.background)
        return counts


