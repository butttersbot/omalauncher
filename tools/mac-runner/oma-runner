changed = threading.Condition()  # guards every thread's state; told whenever an event is added
threads = {}
closing = False


class Thread:
    def __init__(self, meta):
        self.meta = meta
        self.folder = STATE / 'threads' / meta['id']
        self.events = []
        self.queue = meta.setdefault('queue', [])
        self.worker = None
        self.process = None
        self.pending = {}  # approval id -> {'nonce', 'request', 'tool', 'input', 'explanation'}
        self.stopped = False
        self.driver = None
        self.kept = None  # the Claude Code process of this thread, if one is running, turn or no turn (see Kept)
        self.model = meta.get('model_seen') or meta.get('model')  # as the agent reported it, else as asked
        self.model_told = False
        self.bot = None  # this bot's settings as last read (sync_bots), for a bot's session

    def save(self):
        self.meta['model_seen'] = self.model
        self.folder.mkdir(parents=True, exist_ok=True)
        fresh = self.folder / 'thread.json.new'
        fresh.write_text(json.dumps(self.meta, indent=1))
        fresh.replace(self.folder / 'thread.json')

    def emit(self, kind, **data):
        """Adds one event to the thread's record. Call with `changed` held."""
        if kind == 'result' or (kind == 'text' and not self.model_told):
            # The phone labels replies by who wrote them: the model on a turn's first text and on its result.
            data = {**data, 'kind': self.meta['kind'], **({'model': self.model} if self.model else {})}
            self.model_told = True
        event = {'id': len(self.events) + 1, 'time': int(time.time()), 'type': kind, **data}
        self.events.append(event)
        with open(self.folder / 'events.jsonl', 'a') as record:
            record.write(json.dumps(event) + '\n')
        if kind == 'text':
            self.meta['tail'] = data['text'][-300:]
        changed.notify_all()
        return event

    def status(self, status):
        if self.meta.get('status') != status:
            self.meta['status'] = status
            self.save()
            self.emit('status', status=status)

    def view(self):
        return {'id': self.meta['id'], 'name': self.meta['name'], 'project': self.meta['project'], 'home': 'mac',
                'kind': self.meta['kind'], 'mode': mode(self.meta), 'model': self.model, 'summary': self.meta.get('summary', ''), 'status': self.meta['status'],
                'last_worked': self.meta.get('last_worked'), 'tail': self.meta.get('tail', ''), 'waiting_turns': len(self.queue),
                'last_event': len(self.events),
                'bot': self.bot_fields(),
                'background': list(self.kept.driver.background.values()) if self.kept and not self.kept.done else [],
                'pending': [{'approval': key, 'nonce': entry['nonce'], 'tool': entry['tool'], 'input': entry['input'], 'explanation': entry['explanation']} for key, entry in self.pending.items()]}

    def bot_fields(self):
        """What a device shows of a bot's session: who it is, what's wrong with it if anything, how full its memory is."""
        if not self.meta.get('bot'):
            return None
        bot = self.bot or {'id': self.meta['bot'], 'name': self.meta['name'], 'emoji': '', 'problem': None, 'machine': '', 'tools': []}
        memory = self.meta.get('memory') or {}
        return {'id': bot['id'], 'name': bot['name'], 'emoji': bot['emoji'], 'problem': bot['problem'], 'machine': bot['machine'],
                'tools': bot['tools'], 'memory': memory.get('fill', 0), 'summaries': memory.get('summaries', 0)}

    def say(self, message):
        """One line to the agent's stdin. Call with `changed` held."""
        try:
            self.process.stdin.write((json.dumps(message) + '\n').encode())
            self.process.stdin.flush()
            return True
        except (OSError, ValueError, AttributeError):
            return False

    def ask(self, request, tool, given, explanation, **extra):
        """An agent asks to do something: a card for the phone, and the task waits for its answer. Call with `changed` held."""
        approval, nonce = 'a' + secrets.token_hex(6), secrets.token_urlsafe(24)
        self.pending[approval] = {'nonce': nonce, 'request': request, 'tool': tool, 'input': given, 'explanation': explanation, **extra}
        self.status('waiting')
        self.emit('approval', approval=approval, nonce=nonce, tool=tool, input=given, explanation=explanation)

    def withdraw(self, request):
        """The agent took a request back (or it was settled): its card goes. Call with `changed` held."""
        for approval, entry in list(self.pending.items()):
            if entry['request'] == request:
                del self.pending[approval]
                self.emit('approval_result', approval=approval, decision='withdrawn')
                if not self.pending:
                    self.status('working')


def load():
    for file in sorted((STATE / 'threads').glob('*/thread.json')):
        thread = Thread(json.loads(file.read_text()))
        record = thread.folder / 'events.jsonl'
        if record.exists():
            thread.events = [json.loads(line) for line in record.read_text().splitlines() if line.strip()]
        threads[thread.meta['id']] = thread
        if thread.meta['status'] in ('working', 'waiting'):
            # The runner went away under a task. It is not started again: the owner says what happens next.
            with changed:
                thread.status('interrupted')


def allowed_project(given):
    try:
        path = pathlib.Path(str(given)).expanduser().resolve(strict=True)
    except (OSError, RuntimeError, ValueError):
        return None
    if not path.is_dir():
        return None
    for root in ROOTS:
        try:
            base = root.expanduser().resolve(strict=True)
        except OSError:
            continue
        if path == base or base in path.parents:
            return path
    return None


_logged = set()


def log(text, once=False):
    """A line in runner.log (the runner's own output), stamped. [once]: said the first time only, so a phone polling a
    broken handoff doesn't flood the log."""
    if once:
        if text in _logged:
            return
        _logged.add(text)
    print('%s %s' % (time.strftime('%Y-%m-%d %H:%M:%S'), text), flush=True)


def registry():
    """The project registry's entries that can be read: name, folders (as written, ~ allowed, a trailing * a pattern), handoff."""
    try:
        data = json.loads(PROJECTS_FILE.read_text())
    except (OSError, ValueError):
        return []
    # The file is agent-writable: any shape that isn't the registry's is an empty registry, never an error.
    if not isinstance(data, dict) or not isinstance(data.get('projects'), list):
        return []
    found, names = [], set()
    for entry in data['projects']:
        if isinstance(entry, dict) and isinstance(entry.get('name'), str) and re.fullmatch(r'[a-z0-9][a-z0-9._-]{0,62}', entry['name']) and entry['name'] not in names:
            names.add(entry['name'])   # one entry per name, the first, as Soma reads it
            given = entry.get('folders')
            folders = [f for f in given if isinstance(f, str) and f.strip() and len(f) < 512] if isinstance(given, list) else []
            handoff = entry.get('handoff')
            if handoff is not None and handoff not in HANDOFF_FILES:
                log('registry: %s names handoff %r, which is not HANDOFF.md or CURRENT-STATE.md; refused' % (entry['name'], handoff), once=True)
                handoff = None
            found.append({'name': entry['name'], 'folders': folders, 'handoff': handoff})
    return found


def handoff_of(name):
    """The top section of project NAME's handoff file as (file, updated, text), or an error string. Only the registered
    file name, only in one of its registered folders that exists here and resolves under an allowed root."""
    entry = next((e for e in registry() if e['name'] == name), None)
    if entry is None:
        return 'no such project'
    if not entry['handoff']:
        return 'that project has no handoff file'
    for folder in entry['folders']:
        if '*' in folder:
            continue
        base = allowed_project(folder)
        if base is None:
            continue
        # Exactly the registered name in that folder (APFS would also answer to handoff.md).
        try:
            if entry['handoff'] not in os.listdir(base):
                continue
        except OSError:
            continue
        path = base / entry['handoff']
        # One open, one stat, no window between them: never follow a link, never wait on a FIFO, only a plain file
        # with one name (a hard link could be a private file's second name), never one of the runner's own.
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        except OSError:
            log('handoff: %s for %s could not be opened as a plain file; refused' % (path, name), once=True)
            continue
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or (st.st_dev, st.st_ino) in own_files():
                log('handoff: %s for %s is not a plain file of its own; refused' % (path, name), once=True)
                continue
            raw = os.read(fd, HANDOFF_BYTES).decode('utf-8', 'replace')
        except OSError:
            continue
        finally:
            os.close(fd)
        return entry['handoff'], int(st.st_mtime * 1000), top_section(raw)
    return 'no handoff file in that project\'s folders on this machine'


def own_files():
    """(device, inode) of the runner's key files, so no name in a project folder can be one of them."""
    found = set()
    for path in (TOKEN_FILE, KEYS_FILE):
        try:
            st = os.stat(path)
            found.add((st.st_dev, st.st_ino))
        except OSError:
            pass
    return found


# A heading that says what is next ("Next", "Next actions", "3. Next steps", "What's next?"), never one that just has the word.
NEXT_HEADING = re.compile(r"^##\s+\W*(\d+[.)]\s*)?(what['\u2019]?s\s+)?next\b(?![.-]\w)", re.IGNORECASE)


def clip(text, most):
    """[text] cut to [most] characters at a line's end, never inside a code block: a cut that leaves a fence open is
    moved back to before that fence."""
    if len(text) <= most:
        return text
    cut = text[:most]
    if '\n' in cut:
        cut = cut[:cut.rindex('\n')]
    lines = cut.split('\n')
    fences = [i for i, line in enumerate(lines) if line.lstrip().startswith('```')]
    if len(fences) % 2 and fences[-1] > 0:
        lines = lines[:fences[-1]]
    return '\n'.join(lines).rstrip()


def top_section(text):
    """What a handoff card is given: its top (everything before the second level-two heading: the first section, with the
    title above it), then its first later level-two section whose heading says next, if it has one. Headings inside a
    code block are not headings."""
    sections, fenced, headed = [[]], False, False
    for line in text.splitlines():
        if line.lstrip().startswith('```'):
            fenced = not fenced
        elif not fenced and line.startswith('## '):
            # The first level-two heading belongs to the top; each later one starts a section.
            if headed:
                sections.append([])
            headed = True
        sections[-1].append(line)
    top = clip('\n'.join(sections[0]).strip(), 6000)
    nxt = next((s for s in sections[1:] if NEXT_HEADING.search(s[0])), None)
    if nxt is None:
        return top
    return top + '\n\n' + clip('\n'.join(nxt).strip(), 8000 - len(top) - 2)


def make(name, project, kind='claude', model=None, chosen=None):
