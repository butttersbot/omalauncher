def bot_text(path):
    """One of a bot's own files, as text: only a plain file inside its folder, and only so much of it."""
    try:
        if path.is_symlink() or not path.is_file() or path.resolve().parent != path.parent.resolve():
            return None
        with open(path, 'rb') as source:
            return source.read(BOT_FILE_BYTES).decode('utf-8', 'replace')
    except OSError:
        return None


def read_bot(folder):
    """A bot as its folder says: {id, name, emoji, brain, model, web_search, machine, tools, problem}. A bot whose files
    are wrong has a problem, said plainly, and runs nothing."""
    bot = {'id': folder.name, 'name': folder.name, 'emoji': '', 'brain': 'venice', 'model': '', 'web_search': 'off', 'machine': '', 'tools': [], 'problem': None}
    text = bot_text(folder / 'bot.json')
    if text is None:
        bot['problem'] = 'bot.json is missing.'
        return bot
    try:
        given = json.loads(text)
    except ValueError:
        bot['problem'] = 'bot.json is not valid JSON.'
        return bot
    if not isinstance(given, dict):
        bot['problem'] = 'bot.json is not a JSON object.'
        return bot
    name = given.get('name')
    bot['name'] = one_line(name, 40) if isinstance(name, str) and name.strip() else folder.name
    emoji = given.get('emoji')
    bot['emoji'] = one_line(emoji, 8) if isinstance(emoji, str) else ''
    model, brain, search = given.get('model'), given.get('brain', 'venice'), given.get('web_search', 'off')
    machine, tools = given.get('machine'), given.get('tools', [])
    bot.update(model=model if isinstance(model, str) else '', brain=brain, web_search=search, machine=machine if isinstance(machine, str) else '',
               tools=tools if isinstance(tools, list) else [])
    here = own_name_kept()
    if brain != 'venice':
        bot['problem'] = 'bot.json: brain must be "venice" (the only one bots have yet).'
    elif not isinstance(model, str) or not re.fullmatch(r'[A-Za-z0-9][\w.:=,\[\]-]{0,99}', model):
        bot['problem'] = 'bot.json names no model.'
    elif search not in ('off', 'auto', 'on'):
        bot['problem'] = 'bot.json: web_search must be "off", "auto" or "on".'
    elif not isinstance(tools, list) or any(tool != 'shell' for tool in tools):
        bot['problem'] = 'bot.json: tools can only be [] or ["shell"].'
    elif tools and search != 'off':
        bot['problem'] = 'bot.json: a bot with tools must have web_search "off", so what its commands read can\'t go out in a search.'
    elif not isinstance(machine, str) or not machine:
        bot['problem'] = 'bot.json names no machine.'
    elif here and machine.lower() != here:
        bot['problem'] = 'bot.json says it works on %s, but this is %s: its folder belongs on %s.' % (one_line(machine, 63), here, one_line(machine, 63))
    elif bot_text(folder / 'instructions.md') is None:
        bot['problem'] = 'instructions.md is missing.'
    return bot


def bots_here():
    """Every bot folder this machine hosts, by id, read now."""
    try:
        folders = sorted(path for path in BOTS.iterdir() if path.is_dir() and not path.is_symlink() and BOT_ID.fullmatch(path.name))
    except OSError:
        return {}
    return {folder.name: read_bot(folder) for folder in folders}


def sync_bots():
    """Gives each bot here its one session, made the first time the bot is seen, named as the bot is now. A session whose
    bot folder has gone is kept as an ordinary thread. Call with `changed` held."""
    found = bots_here()
    have = {thread.meta['bot']: thread for thread in threads.values() if thread.meta.get('bot')}
    for bot_id, thread in have.items():
        if bot_id not in found:
            thread.meta['bot_gone'], thread.meta['bot'] = bot_id, None
            thread.save()
    for bot_id, bot in found.items():
        work = BOTS / bot_id / 'work'
        try:
            work.mkdir(exist_ok=True)
        except OSError:
            pass
        thread = have.get(bot_id)
        if thread is None:
            entry_id = 't' + secrets.token_hex(4)
            thread = Thread({'id': entry_id, 'name': bot['name'], 'project': str(work), 'kind': 'venice', 'model': bot['model'] or None, 'session': None,
                             'status': 'idle', 'created': int(time.time()), 'last_worked': None, 'summary': '', 'tail': '', 'mode': 'manual', 'bot': bot_id})
            threads[entry_id] = thread
        elif thread.meta['name'] != bot['name'] or thread.meta.get('model') != (bot['model'] or None):
            thread.meta['name'], thread.meta['model'] = bot['name'], bot['model'] or None
        else:
            thread.bot = bot
            continue
        thread.bot = bot
        thread.save()
    return found


def bot_view(bot_id):
    """GET /bots/ID: a bot's settings, instructions and notes, read only; None for a bot this machine doesn't host."""
    if not BOT_ID.fullmatch(bot_id or ''):
        return None
    folder = BOTS / bot_id
    if not folder.is_dir() or folder.is_symlink():
        return None
    return {'bot': read_bot(folder), 'instructions': bot_text(folder / 'instructions.md') or '', 'notes': bot_text(folder / 'notes.md') or ''}


def fresh(thread):
    """A bot's session starts over: its conversation (and summary) go to an archive file in the bot's folder; instructions
    and notes stay. Refused while it works. Call with `changed` held."""
    if not thread.meta.get('bot'):
        return 400, {'ok': False, 'error': 'only a bot starts fresh'}
    if thread.worker is not None or thread.queue:
        return 409, {'ok': False, 'error': 'it is working: stop it first'}
    archive = BOTS / thread.meta['bot'] / 'archive'
    kept = []
    for name in ('venice.json', 'memory.json'):
        source = thread.folder / name
        if source.is_file():
            archive.mkdir(parents=True, exist_ok=True)
            target = archive / ('%s-%s' % (time.strftime('%Y%m%d-%H%M%S'), name))
            shutil.move(str(source), str(target))
            kept.append(str(target))
    thread.emit('note', text='Started fresh. Instructions and notes are kept; the conversation before this is archived in the bot\'s folder.')
    return 200, {'ok': True, 'archived': kept}


