#!/usr/bin/env python3
"""A stand-in for `claude -p --input-format stream-json ... --permission-prompt-tool stdio`, for test-runner.py.

It speaks the same lines Claude Code does and decides what to do from words in the prompt: "write" asks for
approval to write written.txt and writes it only when allowed, in every mode (it stands for what auto mode's
classifier sends to the prompt tool); "edit" writes edited.txt as a routine edit: at once in auto mode, after asking
in any other; "slow" takes three seconds first; "limit" answers as Claude Code does at a usage limit. While a file
named "hold" is in the project, a turn waits for it to go before answering, so a test can keep a turn running. Every start is
added to starts.log in the project, with its permission mode, so a test can see a task was not started twice.

"background" starts a background command ("copy the games", 60 s; "background quick": 2 s) and answers at once. As
Claude Code does (probed 2026-10-14), it then stays alive while that command runs, takes more messages on stdin
(answering each in its own turn), and when the command ends runs a turn of its own reporting it (a task_notification,
then a result naming no message). When stdin closes it waits for the command, reports, and exits. Ended under a
running command, it leaves the command unfinished in the session: the next start that resumes finds it orphaned
and, as Claude Code 2.1 does, first runs a turn of its own about it (a task_notification, then an empty result with
no user_message_uuid) before the owner's message. Results of the owner's turns name the uuid he sent as Claude Code
does, unless the prompt says "old" (a Claude Code from before those fields).
"""
import json, os, pathlib, queue, signal, sys, threading, time, uuid


speaking = threading.RLock()  # one turn at a time on stdout, as Claude Code runs them


def out(event):
    with speaking:
        print(json.dumps(event), flush=True)


def said(text):
    out({'type': 'assistant', 'message': {'role': 'assistant', 'content': [{'type': 'text', 'text': text}]}})


arguments = sys.argv[1:]
session = arguments[arguments.index('--resume') + 1] if '--resume' in arguments and '--fork-session' not in arguments else str(uuid.uuid4())
given = json.loads(sys.stdin.readline())
prompt = given['message']['content']
echo = {'user_message_uuid': given['uuid'], 'user_message_uuids': [given['uuid']]} if given.get('uuid') and 'old' not in prompt else {}
orphan = pathlib.Path('background.running')
with open('starts.log', 'a') as log:
    log.write(json.dumps({'prompt': prompt, 'resumed': '--resume' in arguments, 'forked': '--fork-session' in arguments, 'mode': arguments[arguments.index('--permission-mode') + 1],
                         'deny': json.loads(arguments[arguments.index('--settings') + 1])['permissions']['deny'],
                         'allow': json.loads(arguments[arguments.index('--settings') + 1])['permissions'].get('allow'),
                         'prompt_tool': arguments[arguments.index('--permission-prompt-tool') + 1],
                         'thread_id': os.environ.get('OMA_THREAD_ID'), 'canvas_token': os.environ.get('SOMA_CANVAS_TOKEN'),
                         'soma_service': os.environ.get('SOMA_SERVICE'), 'device_key': 'k' * 40 in json.dumps(dict(os.environ)),
                         'path': os.environ.get('PATH', ''), 'screens': os.environ.get('SOMA_CANVAS_SCREENS'),
                         'soma_thread': os.environ.get('SOMA_THREAD'), 'artifact_token': os.environ.get('SOMA_ARTIFACT_TOKEN'),
                         'system_prompt': arguments[arguments.index('--append-system-prompt') + 1] if '--append-system-prompt' in arguments else None}) + '\n')
if '--model' in arguments:
    with open('models.log', 'a') as log:
        log.write(arguments[arguments.index('--model') + 1] + '\n')
out({'type': 'system', 'subtype': 'init', 'session_id': session, 'model': 'claude-fake'})
if '--resume' in arguments and orphan.exists():
    orphan.unlink()
    out({'type': 'system', 'subtype': 'task_notification', 'task_id': 'b1', 'status': 'stopped', 'output_file': '/tmp/b1.output',
         'summary': "Background shell command didn't finish before the previous session ended", 'session_id': session})
    out({'type': 'result', 'subtype': 'success', 'is_error': False, 'result': '', 'num_turns': 0, 'session_id': session})


running = []


replies = queue.Queue()  # control responses for a card asked in a turn of its own, from the stdin loop below


def work(seconds, words):
    """The background command: it ends after a while (said at once, even in the middle of a turn), and Claude Code
    reports it in a turn of its own. "card" in the words that started it: the report asks to write report.txt;
    "slowreport": the report takes 7 s."""
    time.sleep(seconds)
    orphan.unlink(missing_ok=True)
    out({'type': 'system', 'subtype': 'task_notification', 'task_id': 'b1', 'status': 'completed', 'summary': 'Background command "copy the games" completed (exit code 0)', 'session_id': session})
    out({'type': 'system', 'subtype': 'background_tasks_changed', 'tasks': [], 'session_id': session})
    with speaking:
        out({'type': 'system', 'subtype': 'init', 'session_id': session, 'model': 'claude-fake'})
        if 'slowreport' in words:
            time.sleep(7)
        if 'card' in words:
            given = {'file_path': str(pathlib.Path.cwd() / 'report.txt'), 'content': 'copied'}
            out({'type': 'control_request', 'request_id': 'r-' + uuid.uuid4().hex[:8], 'request': {'subtype': 'can_use_tool', 'tool_name': 'Write', 'input': given}})
            reply = replies.get()['response']['response']
            if reply['behavior'] == 'allow':
                pathlib.Path(reply['updatedInput']['file_path']).write_text(reply['updatedInput']['content'])
        said('The copy finished.')
        out({'type': 'result', 'subtype': 'success', 'is_error': False, 'result': 'The copy finished.', 'session_id': session})


def handle(given):
    prompt = given['message']['content']
    while pathlib.Path('hold').exists():
        time.sleep(0.05)
    echo = {'user_message_uuid': given['uuid'], 'user_message_uuids': [given['uuid']]} if given.get('uuid') and 'old' not in prompt else {}
    with speaking:
        if 'limit' in prompt:
            out({'type': 'assistant', 'error': 'rate_limit', 'message': {'role': 'assistant', 'content': [{'type': 'text', 'text': "You've hit your limit · resets 5pm"}]}})
            out({'type': 'result', 'subtype': 'success', 'is_error': True, 'result': "You've hit your limit · resets 5pm", 'session_id': session, **echo})
            return
        said('Heard: ' + prompt)
        if 'malformed' in prompt:
            out({'type': 'assistant', 'message': {'role': 'assistant', 'content': ['not a block']}})
        if 'slow' in prompt:
            time.sleep(3)
        if 'stubborn' in prompt:  # a turn that won't end for a SIGTERM (send now); says its number first
            import subprocess
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            # And a command in a session of its own, as Claude Code runs one, that won't end for a SIGTERM either.
            helper = subprocess.Popen(['/bin/sh', '-c', 'trap "" TERM; while :; do sleep 1; done'], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            said('Stubborn: %d %d' % (os.getpid(), helper.pid))
            time.sleep(120)
        if 'question-json:' in prompt:  # a form the test gives (test-linked.py: duplicates across threads)
            form = json.loads(prompt.split('question-json:', 1)[1])
            out({'type': 'control_request', 'request_id': 'q-' + uuid.uuid4().hex[:8], 'request': {'subtype': 'can_use_tool', 'tool_name': 'AskUserQuestion', 'input': form}})
            reply = json.loads(sys.stdin.readline())['response']['response']
            said('Answers: ' + json.dumps(reply.get('updatedInput', {}).get('answers', {})) if reply['behavior'] == 'allow' else 'Questions skipped.')
        elif 'question-form' in prompt:
            form = {'questions': [
                {'question': 'Which layout should we use?', 'header': 'Layout', 'options': [{'label': 'Split', 'description': 'Chat stays beside the form'}, {'label': 'Full screen', 'description': 'Focus on the question'}], 'multiSelect': False},
                {'question': 'Which checks should we run?', 'header': 'Checks', 'options': [{'label': 'Cover', 'description': 'Narrow phone'}, {'label': 'Unfolded', 'description': 'Two-pane phone'}], 'multiSelect': True}]}
            out({'type': 'control_request', 'request_id': 'q-' + uuid.uuid4().hex[:8], 'request': {'subtype': 'can_use_tool', 'tool_name': 'AskUserQuestion', 'input': form}})
            reply = json.loads(sys.stdin.readline())['response']['response']
            said('Answers: ' + json.dumps(reply.get('updatedInput', {}).get('answers', {})) if reply['behavior'] == 'allow' else 'Questions skipped.')
        if 'write' in prompt or 'edit' in prompt:
            given = {'file_path': str(pathlib.Path.cwd() / ('written.txt' if 'write' in prompt else 'edited.txt')), 'content': 'hi'}
            out({'type': 'assistant', 'message': {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'tool1', 'name': 'Write', 'input': given}]}})
            if 'edit' in prompt and arguments[arguments.index('--permission-mode') + 1] == 'auto':
                reply = {'behavior': 'allow', 'updatedInput': given}
            else:
                out({'type': 'control_request', 'request_id': 'r-' + uuid.uuid4().hex[:8], 'request': {'subtype': 'can_use_tool', 'tool_name': 'Write', 'input': given}})
                reply = json.loads(sys.stdin.readline())['response']['response']
            if reply['behavior'] == 'allow':
                pathlib.Path(reply['updatedInput']['file_path']).write_text(reply['updatedInput']['content'])
                said('Wrote it.')
            else:
                said('Not allowed, so nothing was written.')
        elif 'scripted' in prompt:
            # A script rewriting an artifact's file and putting it, as one Bash command (how Claude Code often edits one).
            import subprocess
            command = "python3 - <<'EOF' && soma-artifact put mock.html\nopen('mock.html','w').write('<p>scripted</p>')\nEOF"
            out({'type': 'assistant', 'message': {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'tool3', 'name': 'Bash', 'input': {'command': command}}]}})
            time.sleep(0.5)
            pathlib.Path('mock.html').write_text('<p>scripted</p>')
            ran = subprocess.run(['soma-artifact', 'put', 'mock.html'], capture_output=True, text=True)
            said(('ok: ' if ran.returncode == 0 else 'failed: ') + (ran.stdout + ran.stderr).strip())
        elif 'restyle' in prompt:
            # Claude Code's own Write of a file that is already an artifact, then a put, with no "editing" of its own.
            import subprocess
            target = str(pathlib.Path.cwd() / 'mock.html')
            out({'type': 'assistant', 'message': {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'tool2', 'name': 'Write', 'input': {'file_path': target, 'content': 'x'}}]}})
            time.sleep(0.5)
            pathlib.Path(target).write_text('<!doctype html><p>restyled</p>')
            ran = subprocess.run(['soma-artifact', 'put', 'mock.html'], capture_output=True, text=True)
            said(('ok: ' if ran.returncode == 0 else 'failed: ') + (ran.stdout + ran.stderr).strip())
        elif 'mockup' in prompt:
            # An agent making an artifact as the runner tells it to: `soma-artifact` from its PATH, "editing" first.
            # "mockupstuck": it says it is editing and then never puts a version.
            import subprocess
            steps = [['soma-artifact', 'editing', 'mock.html']]
            if 'mockupstuck' not in prompt:
                pathlib.Path('mock.html').write_text('<!doctype html><title>Mock</title><p>' + prompt + '</p>')
                steps.append(['soma-artifact', 'put', 'mock.html', '--title', 'Mock', '--note', prompt[:60]])
            for step in steps:
                ran = subprocess.run(step, capture_output=True, text=True)
                said(('ok: ' if ran.returncode == 0 else 'failed: ') + (ran.stdout + ran.stderr).strip())
        elif 'files' in prompt:
            said('Files here: ' + ', '.join(sorted(path.name for path in pathlib.Path.cwd().iterdir())))
        elif 'background' in prompt:
            task = {'task_id': 'b1', 'task_type': 'local_bash', 'description': 'copy the games'}
            out({'type': 'system', 'subtype': 'task_started', 'session_id': session, **task})
            out({'type': 'system', 'subtype': 'background_tasks_changed', 'tasks': [task], 'session_id': session})
            orphan.write_text('b1')
            running.append(threading.Thread(target=work, args=(2 if 'quick' in prompt else 60, prompt)))
            running[-1].start()
            said('Started copying in the background.')
        out({'type': 'result', 'subtype': 'success', 'is_error': False, 'result': 'done', 'session_id': session, **echo})


handle(given)
for line in sys.stdin:
    if line.strip():
        message = json.loads(line)
        if message.get('type') == 'control_response':
            replies.put(message)
        else:
            handle(message)
for job in running:
    job.join()
