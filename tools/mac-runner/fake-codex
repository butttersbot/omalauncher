#!/usr/bin/env python3
"""A stand-in for `codex app-server`, for test-runner.py. It speaks the JSON-RPC lines Codex's app-server does and
acts on words in the prompt as fake-agent does: "write" asks to add written.txt (under every approval policy: it
stands for a change Codex asks about), "files" lists the folder, "slow" waits, "limit" fails the turn on a usage
limit. Every turn is added to starts.log, with the flags and the approval policy and sandbox it was given."""
import json, pathlib, shlex, sys, time, uuid

arguments = sys.argv[1:]


def out(message):
    print(json.dumps(message), flush=True)


def said(text, phase='commentary'):
    out({'method': 'item/completed', 'params': {'item': {'type': 'agentMessage', 'id': uuid.uuid4().hex, 'text': text, 'phase': phase}}})


def read():
    line = sys.stdin.readline()
    return json.loads(line) if line else None


session, resumed = None, False
while True:
    message = read()
    if message is None:
        break
    method, number, params = message.get('method'), message.get('id'), message.get('params') or {}
    if method == 'initialize':
        out({'id': number, 'result': {'userAgent': 'fake'}})
    elif method == 'thread/turns/list':
        out({'id': number, 'result': {'data': []}})
    elif method == 'thread/read':
        native = pathlib.Path('fake-native.jsonl').resolve()
        if not native.exists():
            native.write_text(json.dumps({'type': 'session_meta', 'payload': {'id': params['threadId']}}) + '\n' +
                              json.dumps({'type': 'event_msg', 'payload': {'type': 'task_complete', 'turn_id': 'last-done'}}) + '\n')
        out({'id': number, 'result': {'thread': {'id': params['threadId'], 'path': str(native)}}})
    elif method in ('thread/start', 'thread/resume', 'thread/fork'):
        if method == 'thread/resume' and params.get('threadId') == '11111111-1111-4111-8111-111111111111' and pathlib.Path('fake-native-writer').exists():
            out({'id': number, 'error': {'code': -32000, 'message': 'thread already has an active writer'}})
            continue
        resumed = method == 'thread/resume'
        session = str(uuid.uuid4()) if method == 'thread/fork' else params.get('threadId') or str(uuid.uuid4())
        rules = params
        out({'id': number, 'result': {'thread': {'id': session}, 'model': params.get('model') or 'gpt-fake'}})
    elif method == 'turn/start':
        prompt = params['input'][0]['text']
        # A new session's first words come after the runner's note on artifacts: what it acts on is his words alone.
        told = prompt.startswith('[Soma (the app Boss is using)')
        prompt = prompt.split(']\n\n', 1)[1] if told else prompt
        with open('starts.log', 'a') as log:
            log.write(json.dumps({'kind': 'codex', 'prompt': prompt, 'told': told, 'resumed': resumed, 'policy': rules.get('approvalPolicy'), 'sandbox': rules.get('sandbox'),
                                  'reviewer': rules.get('approvalsReviewer'), 'arguments': arguments}) + '\n')
        out({'id': number, 'result': {'turn': {'id': 'turn1', 'status': 'inProgress'}}})
        said('Heard: ' + prompt)
        if 'slow' in prompt:
            time.sleep(3)
        if 'limit' in prompt:
            problem = {'message': "You've hit your usage limit. Try again later.", 'codexErrorInfo': 'usageLimitExceeded'}
            out({'method': 'error', 'params': {'error': problem, 'willRetry': False, 'threadId': session, 'turnId': 'turn1'}})
            out({'method': 'turn/completed', 'params': {'threadId': session, 'turn': {'id': 'turn1', 'status': 'failed', 'error': problem, 'items': []}}})
            continue
        if prompt.startswith('approval-command:'):
            spec = json.loads(prompt.split(':', 1)[1])
            asked = {'threadId': session, 'turnId': uuid.uuid4().hex, 'itemId': uuid.uuid4().hex,
                     'command': shlex.join(['/bin/zsh', '-lc', spec['command']]), 'cwd': spec.get('cwd', str(pathlib.Path.cwd())),
                     **spec.get('context', {})}
            out({'method': 'item/commandExecution/requestApproval', 'id': 0, 'params': asked})
            reply = read()
            out({'method': 'serverRequest/resolved', 'params': {'threadId': session, 'requestId': 0}})
            said('Command accepted' if reply['result']['decision'] == 'accept' else 'Command declined', 'final_answer')
        elif 'write' in prompt:
            target = str(pathlib.Path.cwd() / 'written.txt')
            out({'method': 'item/started', 'params': {'item': {'type': 'fileChange', 'id': 'edit1', 'changes': [{'path': target, 'kind': {'type': 'add'}, 'diff': 'hi\n'}], 'status': 'inProgress'}}})
            out({'method': 'item/fileChange/requestApproval', 'id': 0, 'params': {'threadId': session, 'turnId': 'turn1', 'itemId': 'edit1', 'startedAtMs': 0, 'reason': None}})
            reply = read()
            out({'method': 'serverRequest/resolved', 'params': {'threadId': session, 'requestId': 0}})
            if reply['result']['decision'] == 'accept':
                pathlib.Path(target).write_text('hi')
                said('Wrote it.', 'final_answer')
            else:
                said('Not allowed, so nothing was written.', 'final_answer')
        elif 'files' in prompt:
            out({'method': 'item/started', 'params': {'item': {'type': 'commandExecution', 'id': 'run1', 'command': "/bin/zsh -lc 'ls -a'"}}})
            said('Files here: ' + ', '.join(sorted(path.name for path in pathlib.Path.cwd().iterdir())), 'final_answer')
        else:
            said('done', 'final_answer')
        out({'method': 'turn/completed', 'params': {'threadId': session, 'turn': {'id': 'turn1', 'status': 'completed', 'items': []}}})
