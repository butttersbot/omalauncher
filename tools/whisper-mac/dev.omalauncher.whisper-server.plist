<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Oma's dictation on the Mac Pro: whisper.cpp's server on the Tailscale address only. See docs/WHISPER-MAC.md. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.omalauncher.whisper-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/whisper-server</string>
        <string>--model</string>
        <string>/Users/jackkim/.cache/whisper-cpp/ggml-large-v3-turbo.bin</string>
        <string>--host</string>
        <string>100.120.219.46</string>
        <string>--port</string>
        <string>8178</string>
        <string>--threads</string>
        <string>8</string>
        <string>--language</string>
        <string>en</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restarted whenever it ends, including when Tailscale wasn't up yet and the address couldn't be bound. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardOutPath</key>
    <string>/Users/jackkim/Library/Logs/whisper-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jackkim/Library/Logs/whisper-server.log</string>
</dict>
</plist>
