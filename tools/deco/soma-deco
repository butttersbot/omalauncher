#!/usr/bin/env python3
"""
The Deco widget's link to Boss's TP-Link Deco mesh (Boss, 2026-10-28; design: /root/handoff/deco, approved v5).

Talks only to the main Deco's own local API (https://192.168.68.1/cgi-bin/luci), through tplink-deco-api
(github.com/roquerodrigo/tplink-deco-api, inspected at b55c2f8: depends only on `cryptography`, no other hosts).
Nothing here reads or reuses the Deco app's login.

  soma-deco login           Boss types the Deco owner password himself (no echo); kept 0600 in ~/.local/share/soma-deco,
                            never in a synced folder, never printed or logged. Checked against the router first.
  soma-deco poll [--json]   reads the mesh and writes ~/.cache/soma-deco/status.json (and prints it with --json)
  soma-deco speedtest       a real speed test from this phone over the home Wi-Fi (Cloudflare's speed test files); the
                            router's local API only reads its own last test (it starts none: tried 2026-10-28, the Deco
                            app starts those through TP-Link's cloud), so poll records that one, with its real time
  soma-deco restart-plan    prints which Decos a restart would interrupt, and a one-time code for restart
  soma-deco restart CODE    restarts the whole mesh: only with the code restart-plan printed in the last 2 minutes,
                            which the widget asks for only after Boss's inline confirmation naming the Decos
  soma-deco logout          forgets the password

Honest states (status.json "state"): unlinked, unreachable, auth-failed, error, ok. A reading the router didn't give is
null, never 0. Only these router forms are ever called: reads (speedtest read included), reboot write. Never factory.
"""
import contextlib, fcntl, getpass, json, os, secrets, subprocess, sys, time
from pathlib import Path

HOST = os.environ.get("SOMA_DECO_HOST", "192.168.68.1")
HOME = Path.home()
SECRET = HOME / ".local/share/soma-deco/credentials.json"
PLAN = HOME / ".local/share/soma-deco/restart-plan.json"
STATUS = HOME / ".cache/soma-deco/status.json"
LIB = HOME / ".local/share/soma-deco/lib"     # tplink_deco_api at the inspected commit
sys.path.insert(0, str(LIB))

# lastTest*: the router's own last test (the internet line). phoneTest*: Test speed from this phone (its Wi-Fi).
TEST_KEYS = ("lastTestMbps", "lastTestUpMbps", "lastTestPingMs", "lastTestAt", "lastTestLabel",
             "phoneTestMbps", "phoneTestUpMbps", "phoneTestPingMs", "phoneTestAt")
CF = "https://speed.cloudflare.com"

def now(): return int(time.time())

def stamp(t):
    return time.strftime("%H:%M" if time.strftime("%Y%m%d", time.localtime(t)) == time.strftime("%Y%m%d") else "%b %-d %H:%M", time.localtime(t))

def router_test(r):
    """The router's own last speed test (speedtest read), Kbps as it reports them, as status fields; None if it has none."""
    at, down = r.get("last_speed_test_time"), r.get("down_speed")
    if not r.get("ever_tested") or not at or down is None: return None
    up = r.get("up_speed")
    return {"lastTestMbps": round(down / 1000, 1), "lastTestUpMbps": None if up is None else round(up / 1000, 1),
            "lastTestPingMs": r.get("ping_time"), "lastTestAt": int(at), "lastTestLabel": "router test · " + stamp(at)}

@contextlib.contextmanager
def status_lock():
    """One writer of status.json at a time: the widget's poll and Test speed each read it, change it and write it."""
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    with open(STATUS.parent / ".lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield

def write_status(s, router=None):
    with status_lock(): return _write_status(s, router)

def _write_status(s, router):
    old = {}
    try: old = json.loads(STATUS.read_text())
    except Exception: pass
    # The last speed tests belong to the network, not this read: they stay until a newer one replaces them.
    if router: old.update(router)
    for k in TEST_KEYS:
        s.setdefault(k, old.get(k))
    tmp = STATUS.with_suffix(".tmp")
    tmp.write_text(json.dumps(s))
    tmp.replace(STATUS)
    return s

def creds():
    try:
        c = json.loads(SECRET.read_text())
        return c.get("username") or "admin", c["password"]
    except Exception:
        return None

def client(c):
    from tplink_deco_api import DecoClient
    d = DecoClient(HOST, c[0], c[1], timeout=8)
    d.login()
    return d


def link_of(c):
    """How a device is joined, as the router says: Wired, or the Wi-Fi band; None if it doesn't say."""
    if (c.wire_type or "").lower() == "wired" or (c.connection_type or "").lower() == "wired": return "Wired"
    band = {"band2_4": "2.4 GHz", "band5": "5 GHz", "band5_2": "5 GHz", "band6": "6 GHz"}.get((c.connection_type or "").lower())
    return band

def failure(exc):
    name = type(exc).__name__
    if "Authentication" in name: return "auth-failed", "The router refused the password"
    if "Transport" in name or "URLError" in name or "timed out" in str(exc) or "Connection" in name:
        return "unreachable", "Can't reach the Deco at " + HOST
    return "error", (name + ": " + str(exc))[:160]

def poll():
    c = creds()
    base = {"updatedAt": now(), "host": HOST, "connected": False, "devices": None, "nodes": None}
    if not c:
        return write_status({**base, "state": "unlinked", "message": "Not linked: run soma-deco login"})
    try:
        d = client(c)
        clients = [x for x in d.get_client_list() if x.online]
        nodes = d.get_device_list()
        # Names only: the router's per-device speeds aren't live (0 for the Fold under a 300 Mbps download, 2026-10-28),
        # so none are shown (Phone A's call, 2026-10-28).
        devices = sorted(({"id": x.mac, "name": x.name or x.mac, "link": link_of(x)} for x in clients), key=lambda v: v["name"].lower())
        s = {**base, "state": "ok", "connected": True, "devices": devices, "deviceNames": [v["name"] for v in devices],
             "nodes": [{"id": n.mac, "name": n.custom_nickname or n.nickname or n.device_model, "role": n.role, "model": n.device_model} for n in nodes]}
        try: rt = router_test(d.request("admin/device", "speedtest", {"operation": "read"}))
        except Exception: rt = None
        d.logout()
        return write_status(s, rt)
    except Exception as e:
        state, msg = failure(e)
        return write_status({**base, "state": state, "message": msg})

def curl_mbps(args, seconds):
    """Megabits a second curl moved over [args], or None if it failed."""
    try:
        out = subprocess.run(["curl", "-s", "-o", "/dev/null", "-m", str(seconds), "-w", "%{http_code} %{speed_download} %{speed_upload}"] + args,
                             capture_output=True, text=True, timeout=seconds + 5).stdout.split()
    except Exception: return None
    if len(out) != 3 or not out[0].startswith("2"): return None
    v = max(float(out[1]), float(out[2])) * 8 / 1e6
    return round(v, 1) if v > 0 else None

def speedtest():
    """A real test from this phone over the home Wi-Fi: Cloudflare's speed test download and upload, best of a few."""
    ping = None
    try:
        # Time to the first byte after the connection is up: one round trip, not the TLS setup.
        out = subprocess.run(["curl", "-s", "-o", "/dev/null", "-m", "5", "-w", "%{time_appconnect} %{time_starttransfer}", CF + "/__down?bytes=0"],
                             capture_output=True, text=True, timeout=10).stdout.split()
        ping = round((float(out[1]) - float(out[0])) * 1000, 1)
    except Exception: pass
    downs = [curl_mbps([CF + "/__down?bytes=25000000"], 15) for _ in range(3)]    # Cloudflare refuses more than 25 MB at once
    blob = Path("/tmp/soma-deco-up.bin")
    blob.write_bytes(os.urandom(10_000_000))
    ups = [curl_mbps(["--data-binary", "@" + str(blob), CF + "/__up"], 20) for _ in range(3)]
    blob.unlink(missing_ok=True)
    down, up = max((x for x in downs if x), default=None), max((x for x in ups if x), default=None)
    if down is None:
        print("The speed test couldn't reach Cloudflare"); return 1
    with status_lock():
        s = json.loads(STATUS.read_text()) if STATUS.exists() else {}
        s.update({"phoneTestMbps": down, "phoneTestUpMbps": up, "phoneTestPingMs": ping, "phoneTestAt": now()})
        s.pop("rawSpeedtest", None)
        tmp = STATUS.with_suffix(".tmp"); tmp.write_text(json.dumps(s)); tmp.replace(STATUS)
    print(json.dumps({"down": down, "up": up, "pingMs": ping})); return 0

def restart_plan():
    c = creds()
    if not c: print(json.dumps({"ok": False, "message": "Not linked"})); return 2
    d = client(c); nodes = d.get_device_list(); d.logout()
    code = secrets.token_hex(4)
    names = [n.custom_nickname or n.nickname or n.device_model for n in nodes]
    PLAN.parent.mkdir(parents=True, exist_ok=True)
    PLAN.write_text(json.dumps({"code": code, "at": now(), "nodes": [n.mac for n in nodes], "names": names})); os.chmod(PLAN, 0o600)
    print(json.dumps({"ok": True, "code": code, "names": names})); return 0

def restart(code):
    try: plan = json.loads(PLAN.read_text())
    except Exception: print("No restart plan"); return 2
    PLAN.unlink(missing_ok=True)   # one use
    if not code or code != plan.get("code") or now() - plan.get("at", 0) > 120:
        print("That restart was not confirmed in time"); return 2
    c = creds(); d = client(c)
    master = next((n for n in d.get_device_list() if (n.role or "").lower() == "master"), None)
    # The master restarts the whole mesh (docs/endpoints/device.md: "the master can reboot the whole group").
    d.request("admin/device", "reboot", {"operation": "write", "params": {"device_id": "default" if master is None else master.mac}})
    print("Restarting: " + ", ".join(plan.get("names", []))); return 0

def login():
    print("Deco owner password (the one the Deco app signs in with). It is not shown, sent anywhere but the router,")
    print("or written anywhere but " + str(SECRET) + " (only you can read it).")
    pw = getpass.getpass("Password: ")
    if not pw: print("Nothing entered"); return 1
    try:
        d = client(("admin", pw)); d.logout()
    except Exception as e:
        state, msg = failure(e); print("Not saved: " + msg); return 1
    SECRET.parent.mkdir(parents=True, exist_ok=True); os.chmod(SECRET.parent, 0o700)
    fd = os.open(SECRET, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f: json.dump({"username": "admin", "password": pw}, f)
    print("Linked. The Deco widget shows live readings within a minute."); poll(); return 0

def main(a):
    cmd = a[0] if a else "poll"
    if cmd == "poll":
        s = poll()
        if "--json" in a: print(json.dumps(s))
        return 0
    if cmd == "login": return login()
    if cmd == "logout": SECRET.unlink(missing_ok=True); poll(); print("Forgotten"); return 0
    if cmd == "speedtest": return speedtest()
    if cmd == "restart-plan": return restart_plan()
    if cmd == "restart": return restart(a[1] if len(a) > 1 else "")
    print(__doc__); return 2

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
