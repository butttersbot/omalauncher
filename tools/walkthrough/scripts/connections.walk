tap Large
expect Device connections
expect Needs repair
expect Synced
expect Design Canvas
shot connections-large-cover card=connections-large-cover
tap [ Restore ]
expect Restore utility used
expect unavailable
# Utility must not open the modal.
absent Close Connections
tap Connections
tap Connection check:
expect Blocked: active jobs cannot be verified
shot connections-blocked-details-cover card=connections-expanded-blocked-cover
key BACK
tap Active jobs
tap [ Restore ]
expect unavailable
tap Connections
tap Connection check:
expect Blocked: active or queued
key BACK
tap Failed repair
tap [ Restore ]
expect unavailable
shot connections-failed-cover
tap Connections
tap Connection check:
expect Failed: fictional
shot connections-failed-details-cover card=connections-expanded-failed-cover
key BACK
tap Successful repair
tap [ Restore ]
expect Service restored
expect Everything is ready
shot connections-restored-cover
tap Connections
tap Connection check:
expect Restored: fictional
expect Back in working order.
shot connections-restored-details-cover card=connections-expanded-restored-cover
key BACK
tap Auth check
tap Connections
expect Auth required
shot connections-auth-cover
key BACK
tap Stale check
tap Connections
expect Stale
key BACK
tap Pause checks
tap Connections
expect Paused
key BACK
# Models (Boss, 2026-10-30): an agent with a real error says it as printed; one a builder or the front agent needs that isn't installed is Missing and an incident.
tap Models trouble
tap Connections
