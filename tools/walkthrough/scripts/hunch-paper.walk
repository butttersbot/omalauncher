# Original exported HTML, live-data adapter, and source-derived account access.
fold folded
rotate portrait
shell am force-stop dev.omalauncher.hunch
shell am start -n dev.omalauncher.hunch/.MainActivity --es fixture demo
wait 3000
expect "Today's issue"
expect Paper Cranes
absent 169.30
shot hunch-paper-cover
scrollto BIG QUESTIONS
expect BIG QUESTIONS
shot hunch-paper-feed
# Use search instead of coordinates across the original feed panels.
shell am force-stop dev.omalauncher.hunch
shell am start -n dev.omalauncher.hunch/.MainActivity --es fixture demo
wait 3000
tap Search markets
type Paper Cranes
expect Paper Cranes
tap Paper Cranes
scrollto READ ONLY
expect READ ONLY
shot hunch-paper-market
key BACK
expect "Today's issue"
tap Bets
expect No trading account
shot hunch-paper-bets
tap Money
expect verified balances
shot hunch-paper-money
tap Add money
expect FICTIONAL WALLET DEMO
expect Create Hunch wallet
shot hunch-paper-wallet
key BACK
# Approved upright v6 keeps cover-style chapters and bottom tabs.
fold open
rotate portrait
expect Open your wallet
shot hunch-paper-money-inner
tap TODAY
expect PUBLIC MARKETS
shot hunch-paper-discover-inner
tap Paper Cranes
swipe 0.75 0.8 0.75 0.3 500
scrollto READ ONLY
expect READ ONLY
shot hunch-paper-market-inner
key BACK
tap Bets
expect No trading account
shot hunch-paper-bets-inner
# Approved landscape v5 has market list left and My bets/slip right, without chapter tabs.
rotate landscape
expect PUBLIC MARKETS
expect No trading account
expect OPEN WALLET
shot hunch-paper-landscape
rotate portrait
# Reference gallery remains explicitly labelled and cannot call Privy/trading.
shell am force-stop dev.omalauncher.hunch
shell am start -n dev.omalauncher.hunch/.MainActivity --es design Discover
wait 3000
expect DESIGN REFERENCE
shot hunch-paper-reference-discover
[phone] Compare actual installed cover and unfolded screens with original HTML at the same viewport. Check search keyboard, real market metadata, read-only depth, account email/OTP/passkey recovery, offline error, and physical fold state. No wallet/trade actions.
