# Reopening on his last tab (Boss, 2026-10-30: "Just remember which tab I'm on and come back to it. We have way too many
# sessions working at the same time and it keeps dropping me into random sessions."). The real app on the emulator, its
# own test data only: entries land on other tabs while the chat is closed, and a plain open still comes back. What names a
# thread goes there and is then his last tab. Links from outside the chat land here too (soma:// by the manifest's filter).
# canvas-app: soma-chat
fold folded
rotate portrait
shell am force-stop dev.omalauncher.boss
shell am start -W -a dev.omalauncher.action.OMA_CHAT -p dev.omalauncher.boss
wait 1500
tap Show the tabs
tap Phone B
wait 700
expect Nothing has been sent to Phone B
shot last-tab-picked-cover
# Closed, gone from memory, and an entry lands on Phone C. It was the last turn, and used to take him there.
# (Needs at least one entry in the emulator's log already. Soma is the home app, so Android starts it again after a stop: the entry goes in within the stop's own command, before it reads the log.)
shell 'am force-stop dev.omalauncher.boss; sed -i "s/]}$/,{\"time\":$(date +%s)000,\"agent\":\"Claude Code\",\"prompt\":\"walk mail for Phone C\",\"images\":[],\"screen\":false,\"newThread\":true,\"steps\":[],\"result\":\"from the walk\",\"status\":\"done\",\"approvals\":[],\"build\":true,\"builder\":\"C\"}]}/" /data/data/dev.omalauncher.boss/files/oma-chat.json && restorecon /data/data/dev.omalauncher.boss/files/oma-chat.json'
shell am start -W -a dev.omalauncher.action.OMA_CHAT -p dev.omalauncher.boss
wait 1500
expect Nothing has been sent to Phone B
absent walk mail for Phone C
shot last-tab-after-entry-elsewhere-cover
key BACK
wait 1000
absent Nothing has been sent to Phone B
# Named by a tile or a notification: there, and it is his last tab now.
shell am start -W -a dev.omalauncher.action.OMA_CHAT -p dev.omalauncher.boss --es dev.omalauncher.extra.THREAD phone-c
wait 1500
expect walk mail for Phone C
key BACK
wait 1000
shell am start -W -a dev.omalauncher.action.OMA_CHAT -p dev.omalauncher.boss
wait 1500
expect walk mail for Phone C
shot last-tab-named-then-plain-cover card=soma-chat-chat-cover
key BACK
wait 1000
# A link from outside the chat opens Soma on its tab, and reads nothing else off the intent; that is his last tab too.
shell 'am start -W -a android.intent.action.VIEW -d soma://phone/B --es android.intent.extra.TEXT "words from a web page"'
wait 1500
expect Nothing has been sent to Phone B
absent words from a web page
shot link-from-outside-cover
# A dead link from outside while it is open: said, and he stays.
shell am start -W -a android.intent.action.VIEW -d soma://thread/tdeadbeef
wait 3800
expect "Can't find that thread"
expect Nothing has been sent to Phone B
shot link-from-outside-dead-cover
key BACK
wait 1000
# The home tile on page 1 is a plain open: back on Phone B, though its status names Phone C's turn.
wait 1500
shot last-tab-home-before-tile
tap oma
wait 1500
expect Nothing has been sent to Phone B
shot last-tab-from-tile-cover
key BACK
wait 1000
# The remembered tab is gone: the Soma tab, never a blank one.
shell 'am force-stop dev.omalauncher.boss; sed -i "s/>phone-b</>mac:tdeadbeef</" /data/data/dev.omalauncher.boss/shared_prefs/oma-tabs.xml && restorecon /data/data/dev.omalauncher.boss/shared_prefs/oma-tabs.xml'
shell am start -W -a dev.omalauncher.action.OMA_CHAT -p dev.omalauncher.boss
wait 1500
absent Nothing has been sent to
shot last-tab-gone-cover
key BACK
# Unfolded: the same comes back.
shell am force-stop dev.omalauncher.boss
fold open
rotate landscape
wait 900
shell am start -W -a dev.omalauncher.action.OMA_CHAT -p dev.omalauncher.boss --es dev.omalauncher.extra.THREAD phone-b
wait 1500
expect Nothing has been sent to Phone B
shell am force-stop dev.omalauncher.boss
shell am start -W -a dev.omalauncher.action.OMA_CHAT -p dev.omalauncher.boss
wait 1500
expect Nothing has been sent to Phone B
shot last-tab-unfolded card=soma-chat-chat
key BACK
fold folded
rotate portrait
