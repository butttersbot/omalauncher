# Chat links (Boss, 2026-10-30: "You need to be able to send me a link that I can click open on. Then it just takes me to
# the tab."). A real tap on a soma:// link in a chat entry, on the cover and unfolded: a tab in the strip, a tab off the
# strip, a thread on another Mac, a dead link and a malformed one, and Back after each. Fictional fixture running the
# production OmaChatScreen; no agent or Mac is reached. Prerequisite: -PartifactPreview :artifact-preview:assembleDebug installed.
# canvas-app: soma-chat
fold folded
rotate portrait
shell am force-stop dev.omalauncher.artifactpreview
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
expect Connections on the strip
# Look: every link in the theme's link colour, the same as the web link last in the list.
shot links-entry-cover card=soma-chat-chat-cover
# In the strip.
tap Connections on the strip
wait 700
expect Connections audit
# Look: the tab is open, its name in the header, and the strip shows it.
shot links-in-strip-cover card=soma-chat-chat-cover
key BACK
wait 700
absent Connections audit
# Past the strip's edge: the strip scrolls to it.
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
tap Last tab past the edge
wait 900
expect Last tab on the strip
# Look: the strip has scrolled, and that tab is wholly in view, marked open.
shot links-past-edge-cover card=soma-chat-chat-cover
key BACK
wait 700
absent Last tab on the strip
# Off the strip: a tab he has not opened.
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
absent Old notes thread
tap Old notes with no tab
wait 900
expect Old notes thread
# Look: its tab has joined the strip, in view; a sixteen-digit id.
shot links-off-strip-cover card=soma-chat-chat-cover
key BACK
wait 700
absent Old notes thread
# A thread on another Mac.
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
absent MacBook thread
tap Link to the other Mac
wait 900
expect MacBook
# Look: the MacBook thread's tab, the device label "MacBook" in the header.
shot links-other-mac-cover card=soma-chat-chat-cover
key BACK
wait 700
absent MacBook thread
# A phone builder.
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
tap Phone B tab
wait 700
# Look: Phone B's tab is open.
shot links-phone-b-cover card=soma-chat-chat-cover
key BACK
wait 700
# Dead: said in plain words, and he stays. Nothing new on the strip.
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
tap A dead thread
wait 3600
expect "Can't find that thread"
expect A dead thread
# Look: the message above the field; still the same tab and entry; no blank tab.
shot links-dead-cover card=soma-chat-chat-cover
# Malformed: the same.
tap A malformed link
wait 500
expect "That link doesn't open anything"
expect A malformed link
absent "Can't find that thread"
shot links-malformed-cover card=soma-chat-chat-cover
key BACK
wait 700
absent A malformed link
# Unfolded: the same again, each from a new start.
shell am force-stop dev.omalauncher.artifactpreview
fold open
rotate landscape
wait 900
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
expect Connections on the strip
shot links-entry-unfolded card=soma-chat-chat
tap Connections on the strip
wait 700
expect Connections audit
shot links-in-strip-unfolded card=soma-chat-chat
key BACK
wait 700
absent Connections audit
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
tap Old notes with no tab
wait 900
expect Old notes thread
shot links-off-strip-unfolded card=soma-chat-chat
key BACK
wait 700
absent Old notes thread
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
tap Link to the other Mac
wait 900
expect MacBook
shot links-other-mac-unfolded card=soma-chat-chat
key BACK
wait 700
absent MacBook thread
shell am start -W -n dev.omalauncher.artifactpreview/.PreviewActivity --ez links true
tap Show the tabs
tap A dead thread
wait 3600
expect "Can't find that thread"
expect A dead thread
shot links-dead-unfolded card=soma-chat-chat
key BACK
wait 700
absent A dead thread
fold folded
rotate portrait
