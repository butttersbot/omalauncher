# All original source pages, labelled sample data; visual comparison required per shot.
fold folded
rotate portrait
shell am force-stop dev.omalauncher.hunch
shell am start -n dev.omalauncher.hunch/.MainActivity --es design Ask
wait 1500
expect DESIGN REFERENCE
shot hunch-reference-ask
