#!/usr/bin/env python3
"""oma-herd: the Fold's herd reporter (Boss, 2026-10-17: "add the Z Fold 8 to the list of devices in the Agent tab").

The herd (ClaudeSync projects/herd) has each computer run a reporter on port 8479 and every reporter gathers the
others, so the pet everywhere lists their sessions. This is the Fold's: it answers GET /v1/status like `herd node`,
with the phone and its builders (A, B and C), read from the launcher's own status file (~/.cache/oma-agents/status.json,
`oma status`), and GET /v1/sessions/ID with what that builder was asked and last did. Run it under `oma keep`.

Only Boss's computers are answered: the addresses tailshare-serve lists at GET /v1/devices (as `oma msg devices`),
refreshed every few minutes; the phone can't ask `tailscale whois` as the Macs' reporters do.
"""
import json
import os
import pathlib
import re
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get('HERD_PORT', 8479))
STATUS = pathlib.Path.home() / '.cache/oma-agents/status.json'
RUNNERS = pathlib.Path.home() / '.config/omalauncher'
HOST_NAME = os.environ.get('HERD_NAME', 'galaxy-z-fold8')
VERSION = 1
BUILDERS = (('builder', 'fold-builder-a', 'Phone builder A'), ('builderB', 'fold-builder-b', 'Phone builder B'),
            ('builderC', 'fold-builder-c', 'Phone builder C'))

allowed = set()


def mac_hosts():
    """The tailnet addresses of the Macs set up on this phone, from the runner files (no key is read)."""
    hosts = []
    for file in sorted(RUNNERS.glob('mac-runner*.json')):
        try:
            url = json.loads(file.read_text()).get('url', '')
        except (OSError, ValueError):
            continue
        host = re.sub(r'^[a-z]+://', '', url).split(':')[0].split('/')[0]
        if host and host not in hosts:
            hosts.append(host)
    return hosts


def refresh_allowed():
    while True:
        for host in mac_hosts():
            try:
                with urllib.request.urlopen('http://%s:8480/v1/devices' % host, timeout=8) as answer:
                    devices = json.load(answer).get('devices', [])
                found = {d.get('address') for d in devices if d.get('address')}
                if found:
                    allowed.clear()
                    allowed.update(found)
                    break
            except Exception:
                continue
        time.sleep(300)


def status():
    try:
        return json.loads(STATUS.read_text()), STATUS.stat().st_mtime
    except (OSError, ValueError):
        return {}, time.time()


CLAUDE_PROJECTS = pathlib.Path.home() / '.claude/projects'
RECENT_DAYS = 3
TAIL_BYTES = 1024 * 1024
_cache = {}


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return ' '.join(part.get('text', '') for part in content if isinstance(part, dict) and part.get('type') == 'text')
    return ''


def turns_of(path):
    """A session's words, from the end of its transcript: (who, text, at) for each prompt and answer. Cached by mtime."""
    stat = path.stat()
    hit = _cache.get(path)
    if hit and hit[0] == stat.st_mtime:
        return hit[1]
    with open(path, 'rb') as f:
        f.seek(max(0, stat.st_size - TAIL_BYTES))
        lines = f.read().decode('utf-8', 'replace').splitlines()[1:]
    turns = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if entry.get('isSidechain') or entry.get('isMeta'):
            continue
        message = entry.get('message') or {}
        words = text_of(message.get('content')).strip()
        if not words or words.startswith('<'):
            continue
        if entry.get('type') == 'user':
            turns.append(('you', words, entry.get('timestamp')))
        elif entry.get('type') == 'assistant':
            turns.append(('agent', words, entry.get('timestamp')))
    _cache[path] = (stat.st_mtime, turns)
    return turns


def plain(words):
    """What Boss said, on one line: the quick lane's board note before "[Boss says]", or the [bracketed] note a prompt
    arrives with (agent mail, the sheep), is left off."""
    if '[Boss says]' in words:
        words = words.rsplit('[Boss says]', 1)[1]
    elif words.startswith('[') and ']' in words:
        words = words.split(']', 1)[1] or words
    return re.sub(r'\s+', ' ', words).strip()


def sessions():
    """The phone's Claude sessions from the last few days (the builders work in /root), as `herd node` lists a
    computer's: newest first, working while its transcript is still being written and a builder is busy."""
    data, _ = status()
    busy = any((data.get(key) or {}).get('working') for key, _, _ in BUILDERS)
    waiting = any((data.get(key) or {}).get('waitingForApproval') for key, _, _ in BUILDERS)
    now = time.time()
    out = []
    for folder in sorted(CLAUDE_PROJECTS.glob('-root*')):
        for path in folder.glob('*.jsonl'):
            mtime = path.stat().st_mtime
            if now - mtime > RECENT_DAYS * 86400:
                continue
            turns = turns_of(path)
            asked = [t for t in turns if t[0] == 'you']
            if not asked:
                continue
            live = now - mtime < 90
            state = ('needs-you' if waiting else 'working') if live and busy else 'your-turn' if turns[-1][0] == 'agent' else 'idle'
            said = next((t[1] for t in reversed(turns) if t[0] == 'agent'), '')
            out.append({
                'id': path.stem, 'kind': 'claude', 'app': 'fold', 'live': live, 'state': state, 'updated': mtime,
                'title': plain(asked[-1][1])[:80], 'cwd': '/' + folder.name.lstrip('-').replace('-', '/'),
                'project': 'Soma quick answers' if '[Boss says]' in asked[-1][1] else 'Soma on the Fold',
                'last': plain(said)[-200:],
            })
    out.sort(key=lambda s: -s['updated'])
    return out[:8]


def machine():
    info = {'host': HOST_NAME, 'os': 'android', 'herd': VERSION}
    # proot's /proc/uptime stands still; the boot time in /proc/stat is the phone's own.
    try:
        boot = next(int(line.split()[1]) for line in open('/proc/stat') if line.startswith('btime '))
        info['up'] = int(time.time()) - boot
    except (OSError, StopIteration, ValueError):
        pass
    try:
        info['load'] = round(os.getloadavg()[0], 2)
    except OSError:
        pass
    return info


def detail(sid):
    if not re.fullmatch(r'[0-9a-f-]{8,64}', sid):
        return None
    for path in CLAUDE_PROJECTS.glob('-root*/%s.jsonl' % sid):
        turns = [{'who': who, 'text': text, 'at': at} for who, text, at in turns_of(path)[-12:]]
        return {'id': sid, 'turns': turns, 'note': 'A session on the Fold: the full chat is in Soma there.'}
    return None


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def answer(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.client_address[0] not in allowed:
            return self.answer(403, {'error': 'not your device'})
        path = self.path.partition('?')[0]
        parts = [p for p in path.split('/') if p]
        if parts == ['v1', 'status']:
            return self.answer(200, {'machine': machine(), 'sessions': sessions()})
        if len(parts) == 3 and parts[:2] == ['v1', 'sessions']:
            found = detail(parts[2])
            return self.answer(200, found) if found else self.answer(404, {'error': 'no such session here'})
        return self.answer(404, {'error': 'unknown path'})


if __name__ == '__main__':
    threading.Thread(target=refresh_allowed, daemon=True).start()
    ThreadingHTTPServer(('0.0.0.0', PORT), Handler).serve_forever()
