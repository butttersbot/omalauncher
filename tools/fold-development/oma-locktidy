#!/usr/bin/env python3
"""oma-locktidy: lay the lock screen's app widgets out on Oma's home grid.

Samsung's lock-screen editor has no grid: a widget lands where a finger leaves it. This reads the open editor
(Wallpaper and style > Lock screen), snaps every app widget to whole cells of the home grid (six columns across
the screen, the same gap, square cells), packs them from the top left of the room between Samsung's own items
(its clock and widget row above, its messages and shortcuts below), and moves and sizes each by dragging, reading
where it landed and correcting. Samsung's items are not touched. Nothing is saved: press Done, or run with --save.

  oma-locktidy            show what is there and where each widget would go
  oma-locktidy --apply    move and size them
  oma-locktidy --apply --save   and press Done

It drives the phone through oma-phone: on the phone as it is, from the Mac with OMA_PHONE="oma-mac phone".
What it knows of the editor was read off One UI 9 on a Fold's cover screen (2026-10).
"""
import json, math, os, shlex, subprocess, sys, time

PHONE = shlex.split(os.environ.get('OMA_PHONE', 'oma-phone'))
EDITOR = 'com.samsung.android.app.dressroom'
COLUMNS = 6
GAP_SHARE = 1 / 78          # the home grid's gap, as a share of the page's width
NEAR = 4                    # pixels of the preview a widget's size may be off by
CLOSE = 12                  # pixels of the preview a widget may rest from its place: the editor's own stops are this fine
SHORT = 40                  # a drag shorter than this is not a drag to the editor
TRIES = 3


def phone(*args):
    r = subprocess.run(PHONE + [str(a) for a in args], capture_output=True, text=True)
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {'ok': False, 'error': (r.stdout + r.stderr).strip()[:200]}


def view(node):
    return (node.get('viewId') or '').split('/')[-1]


AWAY = None                 # a point of the preview with nothing on it, kept from the last full look


def look():
    """The editor as it stands: the preview's frame, the app widgets, and Samsung's own items."""
    global AWAY
    nodes = phone('read').get('nodes') or []
    if not nodes or nodes[0].get('package') != EDITOR:
        sys.exit('The lock-screen editor is not in front. Open Wallpaper and style > Lock screen first. Nothing was done.')
    # A widget left selected puts its own panel in front, and the layout can't be read through it: tapped away first.
    if AWAY and not any(view(n) == 'confirm_button' for n in nodes) and any(n['text'] == 'Transparency' for n in nodes):
        phone('tap', *AWAY)
        time.sleep(1.2)
        nodes = phone('read').get('nodes') or []
    frame = next((n['bounds'] for n in nodes if n['id'] == 'root.0'), None)
    if frame is None or frame[2] - frame[0] >= 1200 and not any(view(n) == 'confirm_button' for n in nodes):
        sys.exit('This is not the editor\'s layout screen. Nothing was done.')
    widgets = []
    for n in nodes:
        if view(n) != 'contents_container':
            continue
        named = [k for k in nodes if k['id'].startswith(n['id'] + '.') and (k['text'] or k['description'])]
        widgets.append({'name': (named[0]['text'] or named[0]['description']) if named else 'widget', 'b': n['bounds']})
    def holds(g, w):
        return g[0] <= w[0] and g[1] <= w[1] and g[2] >= w[2] and g[3] >= w[3]
    kept = []
    for n in nodes:
        if view(n) != 'item_guide_box_container':
            continue
        b = n['bounds']
        # A widget's own guide box is not something to keep clear of.
        if any(holds(b, w['b']) for w in widgets) and not (n['text'] or n['description']):
            continue
        kept.append({'name': n['text'] or n['description'], 'b': b})
    # Everything that takes a tap is kept clear of when tapping a selection away: Done saves, and it was tapped once.
    taps = [n['bounds'] for n in nodes if n['clickable'] and n['id'] != 'root' and n['bounds'] != frame]
    AWAY = clear_point(frame, [w['b'] for w in widgets] + [k['b'] for k in kept] + taps) or AWAY
    return frame, widgets, kept


class Grid:
    """The home grid over the preview: columns across the whole screen, square cells, rows counted from the top."""

    def __init__(self, frame):
        self.fx, self.fy = frame[0], frame[1]
        self.width, self.height = frame[2] - frame[0], frame[3] - frame[1]
        self.gap = self.width * GAP_SHARE
        self.pitch = (self.width - self.gap) / COLUMNS
        self.rows = int((self.height - self.gap) // self.pitch)

    def box(self, col, row, w, h):
        return [round(self.fx + self.gap + col * self.pitch), round(self.fy + self.gap + row * self.pitch),
                round(self.fx + col * self.pitch + w * self.pitch), round(self.fy + row * self.pitch + h * self.pitch)]

    def span(self, pixels):
        return max(1, round((pixels + self.gap) / self.pitch))


def overlap(a, b):
    return min(a[2], b[2]) > max(a[0], b[0]) and min(a[3], b[3]) > max(a[1], b[1])


def free_rows(grid, frame, kept):
    """The rows Samsung's own items leave free: under its clock and widget row, over its messages and shortcuts."""
    upper = [k['b'][3] for k in kept if k['b'][1] < frame[1] + grid.height * 0.5 and k['b'][2] - k['b'][0] > grid.width * 0.3]
    lower = [k['b'][1] for k in kept if k['b'][1] >= frame[1] + grid.height * 0.5]
    top = max(upper, default=frame[1])
    bottom = min(lower, default=frame[3])
    return [r for r in range(grid.rows) if grid.box(0, r, 1, 1)[1] >= top and grid.box(0, r, 1, 1)[3] <= bottom]


def spot(grid, free, taken, box):
    """The cells for a widget now at [box]: its size to whole cells, at the first place in reading order that is free."""
    cols = min(COLUMNS, grid.span(box[2] - box[0]))
    rows = min(max(1, len(free)), grid.span(box[3] - box[1]))
    for r in free:
        if r + rows - 1 > free[-1]:
            break
        for c in range(COLUMNS - cols + 1):
            cells = grid.box(c, r, cols, rows)
            if not any(overlap(cells, t) for t in taken):
                return [c, r, cols, rows], cells
    return None, None


def order(grid, widgets):
    return sorted(widgets, key=lambda w: (round(w['b'][1] / grid.pitch), w['b'][0]))


def find(name, index):
    frame, widgets, kept = look()
    same = [w for w in widgets if w['name'] == name]
    return frame, widgets, kept, (same[index] if index < len(same) else None)


def clear_point(frame, boxes):
    """A point in the middle band of the preview with nothing on or near it, to tap a selection away."""
    height = frame[3] - frame[1]
    for y in range(frame[1] + height // 4, frame[3] - height // 4, 37):
        for x in range(frame[2] - 60, frame[0] + 60, -41):
            if not any(b[0] - 40 <= x <= b[2] + 40 and b[1] - 40 <= y <= b[3] + 40 for b in boxes):
                return x, y
    return None


SLOP = 0.0                  # how far a finger travels before the editor starts to move a widget; learned as it goes


def drag(name, index, b, dx, dy):
    """Drags the widget at [b] by (dx, dy), allowing for the start of a drag that moves nothing, and learns that allowance."""
    global SLOP
    far = math.hypot(dx, dy)
    ux, uy = dx / far, dy / far
    cx, cy = (b[0] + b[2]) // 2, (b[1] + b[3]) // 2
    phone('swipe', cx, cy, round(cx + dx + ux * SLOP), round(cy + dy + uy * SLOP), 1800)
    time.sleep(1.2)
    _, _, _, w = find(name, index)
    if w is not None:
        went = (w['b'][0] - b[0]) * ux + (w['b'][1] - b[1]) * uy
        SLOP = min(30.0, max(0.0, SLOP + (far - went)))
    return w


def move(name, index, to):
    """Drags the widget towards [to], twice at most, and takes where it then is.

    The editor has stops of its own that a widget comes to rest on, a few pixels from where it was let go; going
    back and forth after those never ends (it did, in front of Boss, 2026-10-12). So a widget within [CLOSE] of
    its place is where it should be, and one that is still further off after two drags is left and reported.
    """
    for _ in range(2):
        _, _, _, w = find(name, index)
        if w is None:
            return 'lost'
        b = w['b']
        dx, dy = to[0] - b[0], to[1] - b[1]
        if math.hypot(dx, dy) <= CLOSE:
            return 'ok'
        if math.hypot(dx, dy) < SHORT:
            # A drag this short is taken for a tap, which selects the widget: it is near enough, and left.
            return 'ok'
        if drag(name, index, b, dx, dy) is None:
            return 'lost'
    _, _, _, w = find(name, index)
    return 'ok' if w and math.hypot(to[0] - w['b'][0], to[1] - w['b'][1]) < SHORT else 'off'


def size(name, index, to):
    for _ in range(TRIES):
        frame, widgets, kept, w = find(name, index)
        if w is None:
            return 'lost'
        b = w['b']
        dw, dh = (to[2] - to[0]) - (b[2] - b[0]), (to[3] - to[1]) - (b[3] - b[1])
        if abs(dw) <= NEAR and abs(dh) <= NEAR:
            return 'ok'
        away = AWAY
        if away is None:
            return 'no clear place to tap a selection away'
        # Selected, a widget shows brackets a little outside its corners; the bottom right one sizes it, its top left stays.
        phone('tap', (b[0] + b[2]) // 2, (b[1] + b[3]) // 2)
        time.sleep(1.2)
        phone('swipe', b[2] + 20, b[3] - 1, b[2] + 20 + dw, b[3] - 1 + dh, 1500)
        time.sleep(1.0)
        # Never Back here: with a widget selected, Back leaves the editor and drops what was not saved.
        phone('tap', *away)
        time.sleep(1.2)
        _, _, _, after = find(name, index)
        if after and after['b'] == b:
            return 'as small or as large as it goes'
    return 'near'


def main():
    apply, save = '--apply' in sys.argv, '--save' in sys.argv
    frame, widgets, kept = look()
    grid = Grid(frame)
    free = free_rows(grid, frame, kept)
    print(json.dumps({'grid': {'columns': COLUMNS, 'rows': grid.rows, 'freeRows': free}, 'widgets': [{'name': w['name'], 'is': w['b']} for w in order(grid, widgets)]}))
    taken, seen = [], {}
    for w in order(grid, widgets):
        index = seen.get(w['name'], 0)
        seen[w['name']] = index + 1
        cells, to = spot(grid, free, taken, w['b'])
        if to is None:
            print(json.dumps({'name': w['name'], 'cells': None, 'why': 'no room left in the free rows'}))
            taken.append(w['b'])
            continue
        if not apply:
            taken.append(to)
            print(json.dumps({'name': w['name'], 'cells': cells, 'wanted': to}))
            continue
        # Moved first so its corner is clear of Samsung's items, sized, then moved again for what sizing shifted.
        steps = [move(w['name'], index, to), size(w['name'], index, to), move(w['name'], index, to)]
        _, _, _, now = find(w['name'], index)
        # One that would not go as small as its cells takes the cells it does cover: the next is kept clear of those.
        taken.append([min(to[0], now['b'][0]), min(to[1], now['b'][1]), max(to[2], now['b'][2]), max(to[3], now['b'][3])] if now else to)
        print(json.dumps({'name': w['name'], 'cells': cells, 'wanted': to, 'is': now['b'] if now else None, 'steps': steps}))
    if apply and save:
        print(json.dumps({'saved': phone('press', '--in', EDITOR, 'Done').get('ok', False)}))


if __name__ == '__main__':
    main()
