#!/bin/sh
set -eu
export ANDROID_HOME=/opt/android-sdk
export ANDROID_SDK_ROOT=/opt/android-sdk
export TMPDIR=/tmp
export JAVA_HOME=/usr/lib/jvm/default
export PATH=/opt/gradle-9.8.0/bin:$PATH
cd /root/Projects/omalauncher
if [ "$#" -eq 0 ]; then set -- :app:testDebugUnitTest :app:assembleDebug; fi
gradle -I /root/.config/oma-development/fold.init.gradle --no-daemon --console=plain "$@"
oma-sync
