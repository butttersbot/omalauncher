#!/usr/bin/env python3
"""soma-lanes: what lets soma-macbuild run one build per phone builder (A, B, C) on the Mac Pro at once.

  soma-lanes hold LOCK SECONDS PARENT_PID TOKEN [WHO]
        waits up to SECONDS for the Mac-wide lock LOCK (a file), then writes TOKEN and holds the lock until PARENT_PID
        ends or this is stopped (SIGTERM). Exits 1 when it waited in vain. The lock is the kernel's (flock), so a build
        that dies never leaves it held, and it is never inherited by Gradle's or adb's daemons.
  soma-lanes claim CODES_FILE LANE COMMIT FLOOR [--exact]
        prints the version code this build is to carry: FLOOR (the phone's next version code) unless another build of
        a different commit already has it, else the first one above that no build has. Two lanes never get the same
        code. --exact (the one-lane way, for a phone whose oma-macbuild takes only FLOOR) never moves off FLOOR and
        says on stderr when that code is another commit's.
  soma-lanes status STATE_DIR
        who holds each lock now, and the codes given.
"""
import fcntl, json, os, pathlib, signal, sys, time


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def hold(path, seconds, parent, token, who=''):
    lock = open(path, 'a+')
    end = time.monotonic() + float(seconds)
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            if time.monotonic() > end or not alive(parent):
                return 1
            time.sleep(.5)
    lock.seek(0); lock.truncate(); lock.write(json.dumps({'who': who, 'pid': parent, 'since': int(time.time())})); lock.flush()
    def done(*_):
        try:
            os.unlink(token)
        except OSError:
            pass
        lock.seek(0); lock.truncate(); lock.flush()
        os._exit(0)
    signal.signal(signal.SIGTERM, done)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    pathlib.Path(token).write_text(str(os.getpid()))
    while alive(parent):
        time.sleep(1)
    done()


def claim(codes_file, lane, commit, floor, exact):
    floor = int(floor)
    path = pathlib.Path(codes_file)
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(str(path) + '.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            codes = json.loads(path.read_text())
        except (OSError, ValueError):
            codes = {}
        # What sits below the phone's next code can never be installed again, so it is forgotten.
        codes = {c: v for c, v in codes.items() if c.isdigit() and int(c) >= floor}
        code = floor
        if exact:
            other = codes.get(str(code))
            if other and other['commit'] != commit:
                print('Version %d was already given to %s (lane %s); built at %d all the same, as asked.'
                      % (code, other['commit'][:9], other['lane'], code), file=sys.stderr)
        else:
            while str(code) in codes and codes[str(code)]['commit'] != commit:
                code += 1
        if not (exact and str(code) in codes):  # the first build given a code keeps it
            codes[str(code)] = {'commit': commit, 'lane': lane, 'at': int(time.time())}
        fresh = path.with_name(path.name + '.new')
        fresh.write_text(json.dumps(codes, indent=1, sort_keys=True) + '\n')
        fresh.replace(path)
    print(code)
    return 0


def status(state):
    state = pathlib.Path(state)
    for lock in sorted(p for p in state.glob('*.lock') if p.name != 'codes.json.lock'):
        try:
            who = json.loads(lock.read_text() or '{}')
        except ValueError:
            who = {}
        held = who.get('pid') and alive(int(who['pid']))
        print('%-14s %s' % (lock.stem, ('held by %s since %s' % (who.get('who') or 'pid %s' % who['pid'],
                                                                time.strftime('%H:%M:%S', time.localtime(who['since']))))
                                       if held else 'free'))
    try:
        codes = json.loads((state / 'codes.json').read_text())
        for code, v in sorted(codes.items(), key=lambda kv: int(kv[0])):
            print('version %s  lane %s  %s' % (code, v['lane'], v['commit'][:9]))
    except (OSError, ValueError):
        pass
    return 0


if __name__ == '__main__':
    args = sys.argv[1:]
    if args[:1] == ['hold'] and len(args) in (5, 6):
        sys.exit(hold(args[1], args[2], int(args[3]), args[4], args[5] if len(args) == 6 else ''))
    if args[:1] == ['claim'] and len(args) in (5, 6):
        sys.exit(claim(args[1], args[2], args[3], args[4], args[5:] == ['--exact']))
    if args[:1] == ['status'] and len(args) == 2:
        sys.exit(status(args[1]))
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)
