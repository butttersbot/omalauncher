#!/bin/bash
# soma-macbuild COMMIT VERSION_CODE [PHONE]: on the Mac Pro, build and test one commit of the phone's branch
# (phone/fold-development) as the working launcher, and Taildrop it to the phone, which signs it with its own key
# and installs it (oma-macbuild --take, then oma-install). Builds run here and not on the Fold (Boss, 2026-10-17:
# the phone's RAM is for Soma). It builds in a worktree of its own beside the mirror at ~/Projects/omalauncher-fold,
# so the mirror stays clean for mac-sync.py. Nothing is sent when a test fails.
set -euo pipefail
[ $# -ge 2 ] || { sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
commit=$1
code=$2
phone=${3:-galaxy-z-fold8}
[[ $commit =~ ^[0-9a-f]{7,40}$ ]] || { echo "\"$commit\" is not a commit." >&2; exit 2; }
[[ $code =~ ^[0-9]{1,9}$ ]] || { echo "\"$code\" is not a version code." >&2; exit 2; }
[[ $phone =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,62}$ ]] || { echo "\"$phone\" is not a device name." >&2; exit 2; }
mirror=$HOME/Projects/omalauncher-fold
work=$HOME/Projects/omalauncher-fold-build

# Only what the phone pushed is built.
git -C "$mirror" fetch --quiet --no-tags fork refs/heads/phone/fold-development:refs/remotes/fork/phone/fold-development
commit=$(git -C "$mirror" rev-parse --verify --quiet "$commit^{commit}") || { echo "No commit $1 here: has the phone pushed it?" >&2; exit 1; }
git -C "$mirror" merge-base --is-ancestor "$commit" fork/phone/fold-development || { echo "$1 is not on phone/fold-development." >&2; exit 1; }
if [ -d "$work" ]; then
  git -C "$work" checkout --quiet --detach --force "$commit"
else
  git -C "$mirror" worktree add --quiet --detach "$work" "$commit"
fi
cd "$work"

# The proot that runs his Linux is not in Git: the pinned, checksummed copies (the phone checks them again).
[ -f app/src/main/jniLibs/arm64-v8a/libproot.so ] || scripts/fetch-proot.sh
# Android Studio's place, or Homebrew's command-line tools (the Mac Pro's).
if [ ! -f local.properties ] && [ -z "${ANDROID_HOME:-}" ]; then
  for sdk in "$HOME/Library/Android/sdk" /opt/homebrew/share/android-commandlinetools; do
    if [ -d "$sdk" ]; then export ANDROID_HOME=$sdk; break; fi
  done
fi

# Exercise the actual browser layout too; JVM tests cannot detect clipped WebView lines.
node_bin=$(command -v node || true)
[ -n "$node_bin" ] || node_bin=/opt/homebrew/bin/node
"$node_bin" tools/news-ui/check.mjs

rm -rf app/build/test-results/testDebugUnitTest
SOMA_VERSION_CODE=$code ./gradlew -I "$work/tools/fold-development/mac.init.gradle" --console=plain \
  :app:testDebugUnitTest :app:assembleDebug

# Counted from the test reports, so the phone sees what passed.
read -r tests failures skipped < <(cat app/build/test-results/testDebugUnitTest/*.xml |
  sed -n 's/.*<testsuite [^>]*tests="\([0-9]*\)"[^>]*skipped="\([0-9]*\)"[^>]*failures="\([0-9]*\)"[^>]*errors="\([0-9]*\)".*/\1 \3 \4 \2/p' |
  awk '{t+=$1; f+=$2+$3; s+=$4} END {print t+0, f+0, s+0}')
[ "$failures" -eq 0 ] || { echo "$failures tests failed; nothing sent." >&2; exit 1; }

apk=app/build/outputs/apk/debug/app-debug.apk
short=${commit:0:9}
name=soma-$short-$code
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
cp "$apk" "$out/$name.apk"
sha=$(shasum -a 256 "$out/$name.apk" | cut -d' ' -f1)
printf '{"commit":"%s","versionCode":%s,"sha256":"%s","tests":%s,"failures":%s,"skipped":%s,"builtAt":"%s"}\n' \
  "$commit" "$code" "$sha" "$tests" "$failures" "$skipped" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$out/$name.json"

ts=$(command -v tailscale || true)
[ -n "$ts" ] || ts=/Applications/Tailscale.app/Contents/MacOS/Tailscale
"$ts" file cp "$out/$name.apk" "$out/$name.json" "$phone:"
cp app/build/news-ui/book.png "$out/news-ui-$short-$code.png"
cp app/build/news-ui/results.json "$out/news-ui-$short-$code.json"
"$ts" file cp "$out/news-ui-$short-$code.png" "$out/news-ui-$short-$code.json" "$phone:"
echo "Built and tested $short (version $code: $tests tests, 0 failed, $skipped skipped); sent $name.apk to $phone."

# Walk it like a person on the Mac's Fold emulator (Boss, 2026-10-22; tools/walkthrough/README.md): the scripts in
# the commit's "Walk:" trailer, else all of them. A failed walk is reported, never a reason to hold the build back.
# Results and screenshots: app/build/walk/ and walk-$short-$code.zip beside the APK.
walks=()
if [ -f tools/walkthrough/walk.py ]; then
  trailer=$(git log -1 --format='%(trailers:key=Walk,valueonly,separator=%x2C)' "$commit" | tr ',' '\n' | sed 's/^ *//; s/ *$//; s/\.walk$//' | sed '/^$/d')
  if [ -n "$trailer" ]; then
    while read -r w; do walks+=("$w"); done <<< "$trailer"
  else
    for f in tools/walkthrough/scripts/*.walk; do [ -e "$f" ] && walks+=("$(basename "$f" .walk)"); done
  fi
fi
if [ ${#walks[@]} -gt 0 ]; then
  set +e
  emu=emulator-5554
  wdir=app/build/walk
  rm -rf "$wdir"; mkdir -p "$wdir"
  started=$(date +%s)
  # The emulator only: it must answer as one (ro.kernel.qemu), never the phone.
  if ! adb -s $emu get-state >/dev/null 2>&1; then tools/oma-emu start --headless >/dev/null; fi
  if [ "$(adb -s $emu shell getprop ro.kernel.qemu 2>/dev/null | tr -d '\r')" != 1 ]; then
    echo "Walks: not run (no emulator at $emu)." | tee "$wdir/summary.txt"
  else
    # Root on the emulator lets a walk open screens that aren't exported (its own test data only).
    adb -s $emu root >/dev/null 2>&1; adb -s $emu wait-for-device
    if ! adb -s $emu install -r -t "$apk" >"$wdir/install.log" 2>&1; then
      echo "Walks: not run (the APK didn't install on the emulator: $(tail -1 "$wdir/install.log"))." | tee "$wdir/summary.txt"
    else
      line="Walks on the emulator:"
      for w in "${walks[@]}"; do
        script=tools/walkthrough/scripts/$w.walk
        if [ ! -f "$script" ]; then line="$line $w MISSING;"; continue; fi
        # Each walk starts on the cover screen, upright, at home.
        adb -s $emu emu fold >/dev/null; adb -s $emu shell settings put system user_rotation 0
        adb -s $emu shell input keyevent HOME
        python3 tools/walkthrough/walk.py "$script" --serial $emu --out "$wdir/$w" > "$wdir/$w.log" 2>&1
        if [ $? -eq 0 ]; then line="$line $w PASS;"
        else line="$line $w FAIL ($(grep -c '^FAIL' "$wdir/$w.log") of $(grep -c '^\(PASS\|FAIL\)' "$wdir/$w.log") steps);"; fi
      done
      echo "${line%;} ($(( $(date +%s) - started )) s)." | tee "$wdir/summary.txt"
      grep -h '^FAIL' "$wdir"/*.log | sed 's/^/  /' | tee -a "$wdir/summary.txt"
    fi
  fi
  (cd "$wdir" && zip -qr "../walk-$short-$code.zip" .)
  cp "app/build/walk-$short-$code.zip" "$out/" && "$ts" file cp "$out/walk-$short-$code.zip" "$phone:"
  set -e
fi
echo "On the phone: oma-macbuild --take, then oma-install."
