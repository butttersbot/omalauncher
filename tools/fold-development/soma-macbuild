#!/bin/bash
# soma-macbuild [--lane A|B|C|D] COMMIT VERSION_CODE [PHONE]: on the Mac Pro, build and test one commit of the phone's
# branch (phone/fold-development) as the working launcher, and Taildrop it to the phone, which signs it with its own key
# and installs it (oma-macbuild --take, then oma-install). Builds run here and not on the Fold (Boss, 2026-10-17:
# the phone's RAM is for Soma). It builds in a worktree of its own beside the mirror at ~/Projects/omalauncher-fold,
# so the mirror stays clean for mac-sync.py. Nothing is sent when a test fails.
# --lane: each phone builder has a lane of its own (its own runner thread and worktree, omalauncher-fold-build-a/-b/-c),
# so the three build at once. Then VERSION_CODE is the lowest it may carry: two lanes never get the same code (the
# next free one is taken and said). Without --lane it builds in omalauncher-fold-build at exactly VERSION_CODE, as
# before. Lanes wait for each other only to fetch, and to walk on the Mac's one emulator, after the app is sent.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
lane=
if [ "${1:-}" = --lane ]; then lane=${2:-}; shift 2 || true; fi
[ $# -ge 2 ] || { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[[ -z $lane || $lane =~ ^[ABCD]$ ]] || { echo "\"$lane\" is not a lane: A, B, C or D." >&2; exit 2; }
commit=$1
code=$2
phone=${3:-galaxy-z-fold8}
[[ $commit =~ ^[0-9a-f]{7,40}$ ]] || { echo "\"$commit\" is not a commit." >&2; exit 2; }
[[ $code =~ ^[0-9]{1,9}$ ]] || { echo "\"$code\" is not a version code." >&2; exit 2; }
[[ $phone =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,62}$ ]] || { echo "\"$phone\" is not a device name." >&2; exit 2; }
mirror=${SOMA_MIRROR:-$HOME/Projects/omalauncher-fold}
legacy=${SOMA_BUILD_ROOT:-$HOME/Projects}/omalauncher-fold-build
work=$legacy${lane:+-$(echo "$lane" | tr ABCD abcd)}
# SOMA_MACBUILD_SEND=0 builds and tests only: nothing goes to the phone and no walk runs (for trying lanes out).
send=${SOMA_MACBUILD_SEND:-1}
# The Mac-wide locks and the version codes given, shared by every lane (soma-lanes status shows them).
state=${SOMA_LANES_STATE:-$HOME/.local/state/soma-macbuild}
mkdir -p "$state"
held=
# hold NAME SECONDS: waits that long at most for the lock NAME, which lasts until let_go NAME or this script ends.
hold() {
  local token="$state/$1.lock.$$"
  rm -f "$token"
  python3 -I "$here/soma-lanes" hold "$state/$1.lock" "$2" $$ "$token" "lane ${lane:-main} building ${commit:0:9}" </dev/null >/dev/null 2>&1 &
  local pid=$!
  while kill -0 "$pid" 2>/dev/null && [ ! -e "$token" ]; do sleep 0.2; done
  [ -e "$token" ] || return 1
  # A lock's name ("lane-A") as a variable name: the dash is no shell name's.
  eval "held_${1//[^A-Za-z0-9_]/_}=$pid"; held="$held $pid"
}
let_go() { local v="held_${1//[^A-Za-z0-9_]/_}"; if [ -n "${!v:-}" ]; then kill "${!v}" 2>/dev/null || true; eval "$v="; fi; }
out=
trap 'for p in $held; do kill $p 2>/dev/null || true; done; [ -z "$out" ] || rm -rf "$out"' EXIT
busy() { python3 -I "$here/soma-lanes" status "$state" | sed -n "s/^$1 *//p"; }

# One build at a time in a lane's worktree (one lane's agent asked twice).
hold "lane-${lane:-main}" 3600 || { echo "Lane ${lane:-main} is still busy after an hour: $(busy "lane-${lane:-main}")." >&2; exit 1; }
# Git's own locks don't let two lanes fetch or make worktrees at once: one at a time, for seconds.
hold git 600 || { echo "Git stayed locked ten minutes: $(busy git)." >&2; exit 1; }
# Only what the phone pushed is built.
git -C "$mirror" fetch --quiet --no-tags fork refs/heads/phone/fold-development:refs/remotes/fork/phone/fold-development
commit=$(git -C "$mirror" rev-parse --verify --quiet "$commit^{commit}") || { echo "No commit $1 here: has the phone pushed it?" >&2; exit 1; }
git -C "$mirror" merge-base --is-ancestor "$commit" fork/phone/fold-development || { echo "$1 is not on phone/fold-development." >&2; exit 1; }
if [ -d "$work" ]; then
  git -C "$work" checkout --quiet --detach --force "$commit"
else
  git -C "$mirror" worktree add --quiet --detach "$work" "$commit"
fi
let_go git
cd "$work"

# The version code: never one another lane was given for another commit (the phone takes any code from its next one up).
asked=$code
exact=--exact
[ -z "$lane" ] || exact=
code=$(python3 -I "$here/soma-lanes" claim "$state/codes.json" "${lane:-main}" "$commit" "$asked" $exact)
code_note=
[ "$code" = "$asked" ] || code_note=" (the phone asked for $asked; that went to another lane's build)"

# The proot that runs his Linux is not in Git: the pinned, checksummed copies (the phone checks them again). A new
# lane takes the copies the first lane already has.
if [ ! -f app/src/main/jniLibs/arm64-v8a/libproot.so ] && [ "$work" != "$legacy" ] && [ -f "$legacy/app/src/main/jniLibs/arm64-v8a/libproot.so" ]; then
  mkdir -p app/src/main/jniLibs && cp -R "$legacy/app/src/main/jniLibs/arm64-v8a" app/src/main/jniLibs/
fi
[ -f app/src/main/jniLibs/arm64-v8a/libproot.so ] || scripts/fetch-proot.sh
# Android Studio's place, or Homebrew's command-line tools (the Mac Pro's).
if [ ! -f local.properties ] && [ -z "${ANDROID_HOME:-}" ]; then
  for sdk in "$HOME/Library/Android/sdk" /opt/homebrew/share/android-commandlinetools; do
    if [ -d "$sdk" ]; then export ANDROID_HOME=$sdk; break; fi
  done
fi
# A Java for Gradle: the one on PATH, else Homebrew's 17 (its real JDK home; the project's toolchain is 17), else Android
# Studio's own 21 (the MacBook Pro has no Java on PATH; with only the 21, :owl wants a 17 toolchain it can't find).
if [ -z "${JAVA_HOME:-}" ] && ! /usr/bin/java -version >/dev/null 2>&1; then
  for jdk in /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home "/Applications/Android Studio.app/Contents/jbr/Contents/Home"; do
    if [ -x "$jdk/bin/java" ]; then export JAVA_HOME=$jdk; break; fi
  done
fi

# Exercise the actual browser layout too; JVM tests cannot detect clipped WebView lines.
node_bin=$(command -v node || true)
[ -n "$node_bin" ] || node_bin=/opt/homebrew/bin/node
"$node_bin" tools/news-ui/check.mjs

rm -rf app/build/test-results/testDebugUnitTest
SOMA_VERSION_CODE=$code ./gradlew -I "$work/tools/fold-development/mac.init.gradle" --console=plain \
  :app:testDebugUnitTest :app:assembleDebug

# Counted from the test reports, so the phone sees what passed.
read -r tests failures skipped < <(cat app/build/test-results/testDebugUnitTest/*.xml |
  sed -n 's/.*<testsuite [^>]*tests="\([0-9]*\)"[^>]*skipped="\([0-9]*\)"[^>]*failures="\([0-9]*\)"[^>]*errors="\([0-9]*\)".*/\1 \3 \4 \2/p' |
  awk '{t+=$1; f+=$2+$3; s+=$4} END {print t+0, f+0, s+0}')
[ "$failures" -eq 0 ] || { echo "$failures tests failed; nothing sent." >&2; exit 1; }

apk=app/build/outputs/apk/debug/app-debug.apk
short=${commit:0:9}
name=soma-$short-$code
out=$(mktemp -d)
cp "$apk" "$out/$name.apk"
sha=$(shasum -a 256 "$out/$name.apk" | cut -d' ' -f1)
printf '{"commit":"%s","versionCode":%s,"sha256":"%s","tests":%s,"failures":%s,"skipped":%s,"builtAt":"%s","lane":"%s"}\n' \
  "$commit" "$code" "$sha" "$tests" "$failures" "$skipped" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${lane:-main}" > "$out/$name.json"
if [ "$send" = 0 ] && [ "${SOMA_MACBUILD_WALK:-0}" != 1 ]; then
  echo "Built and tested $short in lane ${lane:-main} (version $code$code_note: $tests tests, 0 failed, $skipped skipped); not sent (SOMA_MACBUILD_SEND=0)."
  exit 0
fi

# The Mac app's own binary first: Homebrew's symlink to it dies on the MacBook Pro ("bundleIdentifier is unknown to the
# registry"); a Mac with only the Homebrew CLI (the Mac Pro) uses that.
ts=/Applications/Tailscale.app/Contents/MacOS/Tailscale
[ -x "$ts" ] || ts=$(command -v tailscale || true)
if [ "$send" != 0 ]; then "$ts" file cp "$out/$name.apk" "$out/$name.json" "$phone:"; fi
cp app/build/news-ui/book.png "$out/news-ui-$short-$code.png"
cp app/build/news-ui/results.json "$out/news-ui-$short-$code.json"
if [ "$send" != 0 ]; then "$ts" file cp "$out/news-ui-$short-$code.png" "$out/news-ui-$short-$code.json" "$phone:"; fi
echo "Built and tested $short${lane:+ in lane $lane} (version $code$code_note: $tests tests, 0 failed, $skipped skipped); send=$send."

# The walks' verdict goes to whoever asked, by mail, the moment they end (Phone A, 2026-10-26: twice that day the
# result sat unsent for one to two hours). Each walk is its exit and its FAIL lines; each FAIL line says whether it is
# this Mac's environment, the walk script, or something to check. SOMA_MACBUILD_REPORT=0 leaves it to the lane thread.
walk_report() {
  [ "${send:-1}" != 0 ] && [ "${SOMA_MACBUILD_REPORT:-1}" != 0 ] || return 0
  local tmsg; tmsg=$(command -v tmsg || echo "$HOME/.local/bin/tmsg")
  [ -x "$tmsg" ] || { echo "Walk report: no tmsg here, so it wasn't mailed (see $wdir/report.txt)."; return 0; }
  {
    echo "Soma $short (version $code${lane:+, lane $lane}): built and tested ($tests tests, 0 failed, $skipped skipped); $name.apk sent."
    if [ -s "$wdir/verdicts.txt" ]; then
      echo "Walks on $emu, from each walk's exit and FAIL lines:"
      sed 's/^/  /' "$wdir/verdicts.txt"
      for f in "$wdir"/*.log; do
        w=$(basename "$f" .log); grep -q '^FAIL' "$f" || continue
        grep '^FAIL' "$f" | while IFS= read -r l; do
          case $l in
            *Sideways\ book*|*Soma\ Notes*|*Photos\ mode*|*Files\ mode*|*Notes\ mode*|*apple\ store*) k="environment: the Mac Pro's photos/notes" ;;
            *"— unknown"*|*"unknown op"*) k="walk script: not a step walk.py knows" ;;
            *) k="check: app or walk" ;;
          esac
          echo "  $w: ${l:0:150} [$k]"
        done
      done
    else
      cat "$wdir/summary.txt" 2>/dev/null || echo "Walks: none ran."
    fi
    # DESIGN FAIL is its own verdict beside PASS/FAIL: the walk passed, the screen is not as approved.
    [ -s "$wdir/design.txt" ] && cat "$wdir/design.txt"
    echo "Screenshots and logs: walk-$short-$code.zip (Taildropped)."
  } >"$wdir/report.txt"
  local design=""; grep -q '^DESIGN FAIL' "$wdir/design.txt" 2>/dev/null && design=", DESIGN FAIL"
  "$tmsg" send "$phone${lane:+:$lane}" --title "Soma $short walks${lane:+ (lane $lane)}$design" <"$wdir/report.txt" >/dev/null 2>&1 &&
    echo "Walk report mailed to $phone${lane:+:$lane}." || echo "Walk report: mailing it failed (see $wdir/report.txt)."
}

# Walk it like a person on the Mac's Fold emulator (Boss, 2026-10-22; tools/walkthrough/README.md): the scripts in
# the commit's "Walk:" trailer, else all of them. A failed walk is reported, never a reason to hold the build back.
# Results and screenshots: app/build/walk/ and walk-$short-$code.zip beside the APK.
walks=()
if [ -f tools/walkthrough/walk.py ]; then
  trailer=$(git log -1 --format='%(trailers:key=Walk,valueonly,separator=%x2C)' "$commit" | tr ',' '\n' | sed 's/^ *//; s/ *$//; s/\.walk$//' | sed '/^$/d')
  # SOMA_WALKS=all (a promote) walks everything even when the commit names its walks: 169 (e56f09b4c, Walk: phone-d)
  # was asked for all of them and walked phone-d alone.
  if [ -n "$trailer" ] && [ "${SOMA_WALKS:-}" != all ]; then
    while read -r w; do walks+=("$w"); done <<< "$trailer"
  elif [ "${SOMA_WALKS:-}" = all ] || [ ! -s "$state/walked-commit" ] ||
       ! git merge-base --is-ancestor "$(cat "$state/walked-commit")" "$commit" 2>/dev/null; then
    # Everything: asked for (SOMA_WALKS=all, as before a promote), or nothing walked here yet to compare with.
    for f in tools/walkthrough/scripts/*.walk; do [ -e "$f" ] && walks+=("$(basename "$f" .walk)"); done
  else
    # Only the walks what changed since the last walked commit can touch (Boss, 2026-10-26: "do we really need to do
    # these walks after every little change"; all 24 took ~35 minutes for a change to a tool script). Tools, docs and
    # Markdown walk nothing; a walk script that changed walks itself; app code walks the walks for its part.
    changed=$(git diff --name-only "$(cat "$state/walked-commit")" "$commit")
    pick() { for w in "$@"; do [ -e "tools/walkthrough/scripts/$w.walk" ] && walks+=("$w"); done; }
    while IFS= read -r f; do
      case $f in
        tools/walkthrough/scripts/*.walk) pick "$(basename "$f" .walk)" ;;
        hunch/*) pick hunch hunch-auth hunch-bottom-tabs hunch-copy hunch-paper hunch-paper-reference hunch-wallet ;;
        chat/*) pick chat-artifacts chat-return mac-refusal agent-mail-ui codex-phone-copy claude-discovery ;;
        app/src/main/kotlin/dev/omalauncher/news/*) pick news ;;
        app/src/main/kotlin/dev/omalauncher/search/*) pick search ;;
        app/src/main/kotlin/dev/omalauncher/record/*) pick screen-record ;;
        app/src/main/kotlin/dev/omalauncher/keyboard/*) pick gif-keyboard chat-return ;;
        app/src/main/kotlin/dev/omalauncher/phone/*|app/src/main/assets/oma-phone.sh|tools/artifact-preview/*) pick phone-speed background-on-demand ;;
        app/src/main/kotlin/dev/omalauncher/assist/*|app/src/main/assets/oma-msg.sh) pick agent-mail agent-mail-ui agents-page send-now mac-background phone-d ;;
        app/src/main/kotlin/dev/omalauncher/update/*) pick self-install ;;
        app/src/main/kotlin/dev/omalauncher/ui/*|app/src/main/kotlin/dev/omalauncher/theme/*|app/src/main/res/*) pick home-status-bar agents-page search news ;;
        tools/*|docs/*|*.md|scripts/*) ;;
        app/*|build.gradle.kts|settings.gradle.kts|gradle/*) pick home-status-bar chat-return search ;;
      esac
    done <<< "$changed"
    # Each once, in their usual order.
    if [ ${#walks[@]} -gt 0 ]; then
      uniq=(); while IFS= read -r w; do uniq+=("$w"); done < <(printf '%s\n' "${walks[@]}" | sort -u); walks=("${uniq[@]}")
    fi
    [ ${#walks[@]} -gt 0 ] || echo "Walks: none needed (nothing since $(cut -c1-9 "$state/walked-commit") reaches the app's screens)."
  fi
fi
# The Mac has one emulator for walks, so lanes walk one at a time (the app is already on its way to the phone).
# Each lane walks on its own emulator when this Mac has one for it (Fold8-B, Fold8-C beside Fold8), so lanes don't wait
# for each other; a lane without one shares lane A's, one at a time, as before.
emu_lane=A
if [ -n "$lane" ] && [ "$lane" != A ] && [ -d "$HOME/.android/avd/Fold8-$lane.avd" ]; then emu_lane=$lane; fi
export SOMA_EMU_LANE=$emu_lane
walks_lock=walks; [ "$emu_lane" = A ] || walks_lock=walks-$emu_lane
if [ ${#walks[@]} -gt 0 ] && ! hold "$walks_lock" 2700; then
  echo "Walks: not run (the emulator was still walking another lane's build after 45 minutes: $(busy "$walks_lock"))."
  walks=()
fi
if [ ${#walks[@]} -gt 0 ]; then
  set +e
  case $emu_lane in B) emu=emulator-5556 ;; C) emu=emulator-5558 ;; *) emu=emulator-5554 ;; esac
  wdir=app/build/walk
  rm -rf "$wdir"; mkdir -p "$wdir"
  started=$(date +%s)
  # The emulator only: it must answer as one (ro.kernel.qemu), never the phone.
  if ! adb -s $emu get-state >/dev/null 2>&1; then tools/oma-emu start --headless >/dev/null; fi
  if [ "$(adb -s $emu shell getprop ro.kernel.qemu 2>/dev/null | tr -d '\r')" != 1 ]; then
    echo "Walks: not run (no emulator at $emu)." | tee "$wdir/summary.txt"
  else
    # Root on the emulator lets a walk open screens that aren't exported (its own test data only).
    adb -s $emu root >/dev/null 2>&1; adb -s $emu wait-for-device
    # Boss's Fold's bar heights (tools/fold-development/fold8-overlay); Android turns the overlay off at each boot.
    tools/oma-emu fold-bars
    if ! adb -s $emu install -r -t "$apk" >"$wdir/install.log" 2>&1; then
      echo "Walks: not run (the APK didn't install on the emulator: $(tail -1 "$wdir/install.log"))." | tee "$wdir/summary.txt"
    else
      # This walk drives the production chat/WebView through fictional outputs, never a real runner/send.
      # Build without mac.init.gradle: its global .boss suffix belongs only to the working launcher.
      artifact_fixture=0
      for w in "${walks[@]}"; do case $w in chat-artifacts|phone-d) artifact_fixture=1 ;; esac; done
      fixture_ready=1
      if [ "$artifact_fixture" -eq 1 ]; then
        SOMA_VERSION_CODE=$code ./gradlew --console=plain -PartifactPreview :artifact-preview:assembleDebug >"$wdir/artifact-fixture-build.log" 2>&1
        if [ $? -ne 0 ]; then fixture_ready=0
        else
          adb -s $emu install -r -t tools/artifact-preview/build/outputs/apk/debug/artifact-preview-debug.apk >"$wdir/artifact-fixture-install.log" 2>&1 || fixture_ready=0
        fi
      fi
      # The hunch* walks drive the separate Hunch app (built only with -Phunch). An emulator without it fails every step
      # (MacBook Pro, 2026-10-26: the Mac Pro's had one installed by hand), so this commit's Hunch goes on first.
      hunch_walks=0
      for w in "${walks[@]}"; do case $w in hunch*) hunch_walks=1 ;; esac; done
      if [ "$hunch_walks" -eq 1 ]; then
        if ./gradlew --console=plain -Phunch :hunch:assembleDebug >"$wdir/hunch-build.log" 2>&1; then
          hunch_apk=$(ls hunch/build/outputs/apk/debug/*.apk 2>/dev/null | head -n 1)
          if [ -n "$hunch_apk" ] && ! adb -s $emu install -r -t "$hunch_apk" >"$wdir/hunch-install.log" 2>&1; then
            # Another key's Hunch (an earlier hand install) is replaced; it holds only the emulator's own test data.
            adb -s $emu uninstall dev.omalauncher.hunch >/dev/null 2>&1
            adb -s $emu install -r -t "$hunch_apk" >"$wdir/hunch-install.log" 2>&1 || echo "Hunch: didn't install ($(tail -1 "$wdir/hunch-install.log")); the hunch walks will fail on that." >>"$wdir/summary.txt"
          fi
        else
          echo "Hunch: didn't build ($(tail -1 "$wdir/hunch-build.log")); the hunch walks will fail on that." >>"$wdir/summary.txt"
        fi
      fi
      # mac-refusal opens a refused Mac conversation that ChatScreenRenderTest writes out (fictional, no runner); the
      # emulator's own chat history is put back after the walks.
      refusal_ready=1
      for w in "${walks[@]}"; do
        [ "$w" = mac-refusal ] || continue
        refusal_ready=0
        ./gradlew --console=plain :chat:desktopTest --tests dev.omalauncher.oma.ChatScreenRenderTest >"$wdir/mac-refusal-fixture.log" 2>&1 &&
          adb -s $emu push chat/build/render/mac-refusal.json /data/local/tmp/mac-refusal.json >>"$wdir/mac-refusal-fixture.log" 2>&1 &&
          adb -s $emu shell chmod 644 /data/local/tmp/mac-refusal.json && refusal_ready=1
        adb -s $emu shell run-as dev.omalauncher.boss cat files/oma-chat.json >"$wdir/oma-chat.before.json" 2>/dev/null
      done
      line="Walks on the emulator:"
      for w in "${walks[@]}"; do
        if { [ "$w" = chat-artifacts ] || [ "$w" = phone-d ]; } && [ "$fixture_ready" -ne 1 ]; then
          line="$line $w FAIL (fixture build/install; see logs);"; echo "$w FAIL (fixture build/install; see logs)" >>"$wdir/verdicts.txt"; continue
        fi
        if [ "$w" = mac-refusal ] && [ "$refusal_ready" -ne 1 ]; then
          line="$line $w FAIL (fixture build/push; see mac-refusal-fixture.log);"; echo "$w FAIL (fixture build/push; see mac-refusal-fixture.log)" >>"$wdir/verdicts.txt"; continue
        fi
        script=tools/walkthrough/scripts/$w.walk
        if [ ! -f "$script" ]; then line="$line $w MISSING;"; continue; fi
        # Each walk starts on the cover screen, upright, at home.
        adb -s $emu emu fold >/dev/null; adb -s $emu shell settings put system user_rotation 0
        adb -s $emu shell input keyevent HOME
        python3 tools/walkthrough/walk.py "$script" --serial $emu --out "$wdir/$w" > "$wdir/$w.log" 2>&1
        rc=$?
        # The emulator itself fell over mid-walk (a stalled VM killed by its hang detector, MacBook Pro 2026-10-26):
        # every step after says "device not found". That is no verdict on the app: start it again and walk this once more.
        if ! adb -s $emu get-state >/dev/null 2>&1 || grep -q "device '$emu' not found" "$wdir/$w.log"; then
          echo "  ($w: the emulator stopped mid-walk; restarted, walked again)" >>"$wdir/restarts.txt"
          tools/oma-emu start --headless >/dev/null 2>&1 && adb -s $emu install -r -t "$apk" >/dev/null 2>&1
          rm -rf "$wdir/$w"
          python3 tools/walkthrough/walk.py "$script" --serial $emu --out "$wdir/$w" > "$wdir/$w.log" 2>&1
          rc=$?
        fi
        # The verdict is walk.py's own exit and its FAIL lines, never the $? of the retry check above (that read every
        # walk as PASS since the retry came in, 164's hunch-wallet with 5 FAIL steps among them).
        fails=$(grep -c '^FAIL' "$wdir/$w.log")
        if [ "$rc" -eq 0 ] && [ "$fails" -eq 0 ]; then line="$line $w PASS;"; echo "$w PASS" >>"$wdir/verdicts.txt"
        else
          line="$line $w FAIL ($fails of $(grep -c '^\(PASS\|FAIL\)' "$wdir/$w.log") steps${rc:+, exit $rc});"
          echo "$w FAIL ($fails of $(grep -c '^\(PASS\|FAIL\)' "$wdir/$w.log") steps, exit $rc)" >>"$wdir/verdicts.txt"
        fi
      done
      if [ -s "$wdir/oma-chat.before.json" ]; then
        adb -s $emu push "$wdir/oma-chat.before.json" /data/local/tmp/oma-chat.before.json >/dev/null 2>&1 &&
          adb -s $emu shell run-as dev.omalauncher.boss cp /data/local/tmp/oma-chat.before.json files/oma-chat.json
      fi
      echo "${line%;} ($(( $(date +%s) - started )) s)." | tee "$wdir/summary.txt"
      grep -h '^FAIL' "$wdir"/*.log | sed 's/^/  /' | tee -a "$wdir/summary.txt"
      # What the next build compares with, to walk only what changed since (only once walks really ran).
      echo "$commit" > "$state/walked-commit"
    fi
  fi
  # The design gate (design/soma-canvas/DESIGN-GATE.md): each passed walk's carded screenshots (shot NAME card=ID)
  # become Shipped on Soma Canvas and are checked against Approved; take and install refuse unwaived drift.
  if [ -s "$wdir/verdicts.txt" ] && ls "$wdir"/*/canvas.json >/dev/null 2>&1; then
    python3 tools/walkthrough/design_gate.py run "$wdir" --version "$code" --build "$short" > "$wdir/design.txt" 2>&1
    cat "$wdir/design.txt"
    if [ -s "$wdir/design-report.json" ]; then
      cp "$wdir/design-report.json" "$out/design-$short-$code.json"
      if [ "$send" != 0 ]; then "$ts" file cp "$out/design-$short-$code.json" "$phone:"; fi
    fi
  fi
  (cd "$wdir" && zip -qr "../walk-$short-$code.zip" .)
  cp "app/build/walk-$short-$code.zip" "$out/"
  if [ "$send" != 0 ]; then "$ts" file cp "$out/walk-$short-$code.zip" "$phone:"; fi
  walk_report
  set -e
fi
echo "On the phone: oma-macbuild --take, then oma-install."
