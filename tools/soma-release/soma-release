#!/usr/bin/env python3
"""soma-release: publishes the latest desktop build for the update pill (Boss approved on Soma Canvas, soma-desktop/Updates).

  soma-release publish --repo DIR --receipt FILE --artifact KEY=PATH ... [--notes-file FILE]
  soma-release show

publish writes RELEASE/<commit>/ (each artifact, and the runner's tarball made here from tools/mac-runner) and then
RELEASE/latest.json, the record each Soma reads over its runners (GET /release): commit, when it was committed, what
changed, and every file with its sha256. It refuses unless the checkout is clean at the commit the receipt names, and the
receipt says every suite passed: build-release.sh writes it only then. KEY is the platform a file is for: macos-arm64 (a
zipped Soma.app), linux-x64 (the jar). Nothing installs anywhere; each Soma asks Boss first.
"""
import argparse, hashlib, io, json, os, pathlib, re, shutil, subprocess, sys, tarfile, time

RELEASE = pathlib.Path(os.environ.get('OMA_RUNNER_RELEASE') or pathlib.Path.home() / '.local/share/soma-release')
PLATFORMS = ('macos-arm64', 'macos-x64', 'linux-x64', 'linux-arm64')
KEEP = 3  # builds kept in the folder, the newest first: the one offered and two before it
MOST_NOTES = 8


def git(repo, *words):
    return subprocess.run(['git', '-C', str(repo), *words], capture_output=True, text=True, check=True).stdout.strip()


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


def notes(repo, commit, previous):
    """What changed, in the commits' own first lines: since the build published before, when it is this one's ancestor."""
    since = previous and subprocess.run(['git', '-C', str(repo), 'merge-base', '--is-ancestor', previous, commit]).returncode == 0
    lines = git(repo, 'log', '--no-merges', '--format=%s', (previous + '..' + commit) if since else '-5', *(() if since else (commit,))).splitlines()
    lines = [l.strip() for l in lines if l.strip()]
    if len(lines) > MOST_NOTES:
        lines = lines[:MOST_NOTES] + ['and %d more' % (len(lines) - MOST_NOTES)]
    return lines


def runner_tarball(repo, commit, into):
    """The runner as installed (oma-runner and soma_services.py), with oma-runner.build saying its commit (/health shows it)."""
    path = into / ('oma-runner-%s.tar.gz' % commit)
    files = {name: (repo / 'tools/mac-runner' / name).read_bytes() for name in ('oma-runner', 'soma_services.py')}
    files['oma-runner.build'] = (commit + '\n').encode()
    with tarfile.open(path, 'w:gz') as tar:
        for name, data in files.items():
            info = tarfile.TarInfo(name)
            info.size, info.mode, info.mtime = len(data), 0o755 if name == 'oma-runner' else 0o644, 0
            tar.addfile(info, io.BytesIO(data))
    return path


def previous_commit():
    try:
        return json.loads((RELEASE / 'latest.json').read_text()).get('commit')
    except (OSError, ValueError, AttributeError):
        return None


def publish(args):
    repo = pathlib.Path(args.repo).resolve()
    receipt = json.loads(pathlib.Path(args.receipt).read_text())
    head = git(repo, 'rev-parse', 'HEAD')
    commit = head[:8]
    if git(repo, 'status', '--porcelain'):
        sys.exit('soma-release: the checkout has changes; only a committed build is published.')
    if receipt.get('commit') != head or not receipt.get('suites') or any(s.get('exit') != 0 for s in receipt['suites']):
        sys.exit('soma-release: the receipt is not a passing run of this commit (%s); nothing was published.' % commit)
    given = {}
    for item in args.artifact:
        key, _, path = item.partition('=')
        if key not in PLATFORMS or not pathlib.Path(path).is_file():
            sys.exit('soma-release: %s is not PLATFORM=FILE with PLATFORM one of %s' % (item, ', '.join(PLATFORMS)))
        given[key] = pathlib.Path(path)
    if not given:
        sys.exit('soma-release: no app to publish.')
    into = RELEASE / commit
    staging = RELEASE / ('.%s.new' % commit)
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True)
    artifacts = {}
    for key, path in given.items():
        name = 'Soma-%s-%s%s' % (key, commit, ''.join(path.suffixes[-1:]))
        shutil.copyfile(path, staging / name)
        artifacts[key] = {'file': name, 'sha256': sha256(staging / name), 'size': (staging / name).stat().st_size}
    tarball = runner_tarball(repo, commit, staging)
    artifacts['runner'] = {'file': tarball.name, 'sha256': sha256(tarball), 'size': tarball.stat().st_size}
    previous = previous_commit()
    record = {'commit': commit, 'committed': int(git(repo, 'log', '-1', '--format=%ct', head)), 'published': int(time.time()),
              'previous': previous, 'notes': [l for l in pathlib.Path(args.notes_file).read_text().splitlines() if l.strip()] if args.notes_file else notes(repo, head, previous),
              'tests': [s['name'] for s in receipt['suites']], 'source': os.uname().nodename.split('.')[0], 'artifacts': artifacts}
    shutil.rmtree(into, ignore_errors=True)
    staging.rename(into)
    # The record last, whole or not at all: a Soma reading it mid-publish sees the build before.
    temp = RELEASE / '.latest.json.new'
    temp.write_text(json.dumps(record, indent=2) + '\n')
    os.replace(temp, RELEASE / 'latest.json')
    for old in sorted((d for d in RELEASE.iterdir() if d.is_dir() and re.fullmatch(r'[0-9a-f]{8}', d.name)), key=lambda d: d.stat().st_mtime, reverse=True)[KEEP:]:
        shutil.rmtree(old, ignore_errors=True)
    print('published %s: %s' % (commit, ', '.join(sorted(artifacts))))
    for line in record['notes']:
        print('  ' + line)


def show(_):
    path = RELEASE / 'latest.json'
    print(path.read_text() if path.exists() else 'nothing published in %s' % RELEASE)


def main():
    parser = argparse.ArgumentParser(prog='soma-release')
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('publish')
    p.add_argument('--repo', required=True)
    p.add_argument('--receipt', required=True)
    p.add_argument('--artifact', action='append', default=[])
    p.add_argument('--notes-file')
    p.set_defaults(run=publish)
    sub.add_parser('show').set_defaults(run=show)
    args = parser.parse_args()
    args.run(args)


if __name__ == '__main__':
    main()
