#!/usr/bin/env bash
# Soma Canvas from the Fold: reads which server to use (and who we are) from ~/.config/soma-canvas/env, then runs the
# real CLI. The token is in ~/.config/soma-canvas/token (mode 600). While the Mac Pro is away the server is the MacBook.
[ -f "$HOME/.config/soma-canvas/env" ] && set -a && . "$HOME/.config/soma-canvas/env" && set +a
exec "$(dirname "$0")/soma-canvas.real" "$@"
