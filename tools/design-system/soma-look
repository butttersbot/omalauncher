#!/usr/bin/env python3
"""
soma-look FILE.html [--sizes cover,unfolded,side] [--out DIR]

Looks at a mockup the way Boss will see it, before anyone sends it: renders FILE at the Fold's sizes
(cover full screen 475x751, unfolded 932x704, side panel 466x704, in CSS px), checks the page for what keeps going
wrong, prints a PNG per size.

Checks, inside the page at each size:
  empty      content with no height (a fit() that scales to nothing, a height that comes out 0)
  tiny       text drawn at under 20% scale (transform: scale from a measured height)
  overflow   the page wider than the screen (sideways scrolling)
  clipped    text cut off by a box with overflow hidden
  overlap    two pieces of text drawn over each other
  look       made for another look than the active one, or not from the template
And on the file: references to the network (http/https in src, href, url(), @import): mockups are offline.
  FONT FALLBACK   a character none of the page's fonts draws, so a device font would: checked against the theme's
                  fonts in Soma Canvas's store (the faces the page carries, by file hash, and what each covers).
                  Emoji and CJK the page uses but doesn't carry: build.py --inline FILE adds just those faces.

On the phone it uses the hidden display (oma-phone --display bg) and Brave; the artifact panel's WebView differs a
little (no network, no storage), so treat this as the minimum, not the final word.
Exit 0: looked, no errors (warnings may remain). Exit 1: errors, fix before sending. Exit 2: couldn't look.
"""
import argparse, hashlib, http.server, json, os, re, shutil, socket, subprocess, sys, tempfile, threading, time
# somafonts.py sits beside this in tools/design-system (and beside the installed copy in ~/.local/bin).
for _d in (os.path.dirname(os.path.realpath(__file__)), "/root/Projects/omalauncher/tools/design-system"):
    if os.path.isfile(os.path.join(_d, "somafonts.py")):
        sys.path.insert(0, _d); break
try:
    import somafonts
except ImportError:
    somafonts = None

SIZES = {"cover": (475, 751), "unfolded": (932, 704), "side": (466, 704)}
CACHE = os.path.expanduser("~/.cache/soma-look")

HARNESS = r"""<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<style>html,body{margin:0;background:#ff00ff;overflow:hidden;height:100%}body{padding:8px;box-sizing:border-box}iframe{border:0;transform-origin:0 0;background:#fff;display:block}</style>
</head><body><iframe id="f"></iframe><script>
const q=new URLSearchParams(location.search),w=+q.get('w'),h=+q.get('h'),f=document.getElementById('f');
f.width=w;f.height=h;f.style.width=w+'px';f.style.height=h+'px';
const s=Math.min((innerWidth-16)/w,(innerHeight-16)/h);f.style.transform='scale('+s+')';
f.onload=()=>setTimeout(()=>{let r;try{r=check(f.contentDocument,f.contentWindow)}catch(e){r={errors:['could not inspect: '+e],warnings:[]}}
 r.size=[w,h];fetch('/report?k='+q.get('k'),{method:'POST',body:JSON.stringify(r)})},1200);
f.src='page.html?'+Date.now();
function check(d,win){
 const E=[],W=[],b=d.body;if(!b)return{errors:['no <body>'],warnings:[]};
 const txt=(b.innerText||'').trim();
 const vis=[...b.querySelectorAll('*')].filter(e=>{const r=e.getBoundingClientRect();return r.width>1&&r.height>1});
 let maxB=0;vis.forEach(e=>{const r=e.getBoundingClientRect();maxB=Math.max(maxB,r.bottom)});
 if(txt&&maxB<24)E.push('empty: the page has text but nothing is drawn taller than 24px (zero-height content?)');
 const leaves=[];const tw=d.createTreeWalker(b,NodeFilter.SHOW_TEXT);let n;
 while((n=tw.nextNode())&&leaves.length<600){if(!n.textContent.trim())continue;const rg=d.createRange();rg.selectNodeContents(n);
  const rs=[...rg.getClientRects()].filter(r=>r.width>0&&r.height>0);if(!rs.length)continue;
  const el=n.parentElement,cs=win.getComputedStyle(el);if(cs.visibility==='hidden'||+cs.opacity===0)continue;
  leaves.push({el,rs,t:n.textContent.trim().slice(0,40)});}
 // tiny: text whose drawn height is far below its font size
 leaves.forEach(l=>{const fs=parseFloat(win.getComputedStyle(l.el).fontSize)||0,hgt=Math.max(...l.rs.map(r=>r.height));
  if(fs>=8&&hgt<fs*0.2)E.push('tiny: "'+l.t+'" is drawn at '+Math.round(hgt*10)/10+'px for a '+fs+'px font (scaled to nothing?)')});
 if(d.documentElement.scrollWidth>w+1)W.push('overflow: the page is '+d.documentElement.scrollWidth+'px wide on a '+w+'px screen');
 // clipped
 [...b.querySelectorAll('*')].forEach(e=>{const cs=win.getComputedStyle(e);if(!/(hidden|clip)/.test(cs.overflowX+cs.overflowY))return;
  if(!(e.innerText||'').trim())return;if(e.scrollWidth>e.clientWidth+2||e.scrollHeight>e.clientHeight+2)
  W.push('clipped: text cut off in <'+e.tagName.toLowerCase()+(e.className?'.'+String(e.className).split(' ')[0]:'')+'> "'+(e.innerText||'').trim().slice(0,30)+'"')});
 // overlap
 const box=l=>l.rs.reduce((a,r)=>({l:Math.min(a.l,r.left),t:Math.min(a.t,r.top),r:Math.max(a.r,r.right),b:Math.max(a.b,r.bottom)}),{l:1e9,t:1e9,r:-1e9,b:-1e9});
 const bx=leaves.map(box);let ov=0;
 for(let i=0;i<leaves.length&&ov<12;i++)for(let j=i+1;j<leaves.length&&ov<12;j++){
  const a=leaves[i],c=leaves[j];if(a.el===c.el||a.el.contains(c.el)||c.el.contains(a.el))continue;
  for(const r1 of a.rs)for(const r2 of c.rs){const x=Math.min(r1.right,r2.right)-Math.max(r1.left,r2.left),y=Math.min(r1.bottom,r2.bottom)-Math.max(r1.top,r2.top);
   if(x>3&&y>Math.min(r1.height,r2.height)*0.3){W.push('overlap: "'+a.t+'" and "'+c.t+'" are drawn over each other');ov++;break}}}
 return{errors:[...new Set(E)].slice(0,20),warnings:[...new Set(W)].slice(0,30),height:Math.round(maxB)};}
</script></body></html>"""


def run(cmd, timeout=60):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def card_checks(html):
    """The Canvas cards a review mockup declares (meta soma-canvas-cards, {app, cards, version}) must exist and carry
    that proposal version, or Boss would approve screens that aren't the ones he's looking at."""
    m = re.search(r"""<meta\s+name=["']soma-canvas-cards["']\s+content='([^']*)'""", html) or \
        re.search(r'<meta\s+name=["\']soma-canvas-cards["\']\s+content="([^"]*)"', html)
    if not m:
        return []
    try:
        decl = json.loads(m.group(1).replace("&quot;", '"'))
        app, cards, version = decl["app"], decl["cards"], decl["version"]
    except Exception as e:
        return [f"cards: soma-canvas-cards isn't {{app, cards, version}} JSON ({e})"]
    if app == "your-app":
        return []      # the template's placeholder: an ordinary mockup, not a Canvas review
    env = os.path.expanduser("~/.config/soma-canvas/env"); url = None
    if os.path.exists(env):
        u = re.search(r"CANVAS_URL=(\S+)", open(env).read()); url = u and u.group(1)
    tok = os.path.expanduser("~/.config/soma-canvas/token")
    if not url or not os.path.exists(tok):
        return ["cards: can't reach Soma Canvas to check the declared cards (no ~/.config/soma-canvas)"]
    out = []
    for cid in cards:
        r = run(["curl", "-s", "--max-time", "8", "-H", f"x-canvas-token: {open(tok).read().strip()}", f"{url}/api/cards/{cid}"], 15)
        try:
            card = json.loads(r.stdout)
        except Exception:
            out.append(f"cards: {cid}: no answer from Soma Canvas"); continue
        card = card.get("card", card)
        if card.get("error") or not card.get("id"):
            out.append(f"cards: {cid}: no such card"); continue
        prop = (card.get("states") or {}).get("proposed") or card.get("proposed")
        if not prop:
            out.append(f"cards: {cid}: has no proposal to approve"); continue
        if prop.get("version") and prop["version"] != version:
            out.append(f"cards: {cid}: its proposal is {prop['version']}, the mockup says {version}")
    return out


def free_port():
    s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p


def static_checks(html):
    errs = []
    for m in re.finditer(r"""(?:src|href)\s*=\s*["'](https?://[^"']+)|url\(\s*["']?(https?://[^)"']+)|@import\s+["']?(https?://[^"';]+)""", html, re.I):
        url = next(g for g in m.groups() if g)
        errs.append(f"network: {url[:80]} (mockups are offline single files)")
    return errs[:10]


def font_checks(html, active=None):
    """FONT FALLBACK: (errors, warnings). The theme is the page's soma-fonts/soma-pack meta, else the active look."""
    if somafonts is None:
        return [], ["fonts: somafonts.py not found beside soma-look, so FONT FALLBACK wasn't checked"]
    m = re.search(r'<meta name="soma-(?:fonts|pack)" content="([\w-]+)', html)
    theme = m.group(1) if m else active
    if not theme:
        return [], ["fonts: no theme (no soma-fonts meta, no active look), so FONT FALLBACK wasn't checked"]
    manifest, _ = somafonts.fetch(theme)
    if not manifest:
        return [], [f"fonts: no font store for '{theme}' (Canvas out of reach, nothing cached), so FONT FALLBACK wasn't checked"]
    missing, could = somafonts.fallback(html, manifest)
    if not missing:
        return [], []
    chars = " ".join(f"{c} {u}" for c, u in missing[:24]) + (f" (+{len(missing) - 24} more)" if len(missing) > 24 else "")
    theme_faces = sorted({f["family"] for f in could if f.get("bundle")})
    extra = sorted({f["family"] for f in could if not f.get("bundle")})
    if theme_faces:
        fix = (f"; the page doesn't carry the theme's own fonts from the store ({', '.join(theme_faces)}): rebuild "
               "(tools/design-system/build.py) and recopy soma.css from design/soma/template.html"
               + (f", then build.py --inline FILE for {', '.join(extra)}" if extra else ""))
    elif extra:
        fix = f"; the store has them in {', '.join(extra)}: run tools/design-system/build.py --inline FILE"
    else:
        fix = "; no font in the store draws them: change the text or ask for the font"
    return [f"FONT FALLBACK: {len(missing)} character(s) no font in this page draws (a device font would): {chars}{fix}"], []


def crop(png, out):
    """The harness draws the page in a frame inside an 8 px magenta margin: find the frame by where the magenta stops."""
    from PIL import Image
    im = Image.open(png).convert("RGB"); px = im.load(); W, H = im.size
    mag = lambda c: c[0] > 220 and c[1] < 60 and c[2] > 220
    col = [y for y in range(H) if mag(px[3, y])]          # the left margin runs the harness's full height
    if not col:
        im.save(out); return False
    top, bottom = col[0], col[-1]
    y = top
    while y < bottom and all(mag(px[x, y]) for x in range(3, min(W, 400), 37)): y += 1   # past the top margin
    probe = min(bottom - 1, y + 40)
    x0 = 3
    while x0 < W - 1 and mag(px[x0, probe]): x0 += 1
    x1 = x0
    while x1 < W - 1 and not mag(px[x1, probe]): x1 += 1
    y1 = y
    while y1 < bottom and not mag(px[x0 + 5, y1]): y1 += 1
    if x1 - x0 < 20 or y1 - y < 20:
        im.save(out); return False
    im.crop((x0, y, x1, y1)).save(out); return True


def main():
    a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    a.add_argument("file"); a.add_argument("--sizes", default="cover,unfolded,side"); a.add_argument("--out")
    o = a.parse_args()
    path = os.path.abspath(o.file)
    if not os.path.isfile(path):
        sys.exit(f"soma-look: no such file: {o.file}")
    data = open(path, "rb").read(); sha = hashlib.sha256(data).hexdigest()
    out = o.out or os.path.join(CACHE, sha[:16]); os.makedirs(out, exist_ok=True)
    errors, warnings, shots = static_checks(data.decode("utf-8", "replace")), [], {}
    m = re.search(r'<meta name="soma-pack" content="([\w-]+)"', data.decode("utf-8", "replace"))
    try:
        active = json.loads(run(["oma-phone", "looks"], 20).stdout).get("look")
    except Exception:
        active = None
    if m and active and m.group(1) != active:
        warnings.append(f"look: made for the '{m.group(1)}' look but '{active}' is active; rebuild (tools/design-system/build.py) and recopy soma.css")
    elif not m:
        warnings.append("look: no <meta name=\"soma-pack\">; start from design/soma/template.html so it follows the active look")

    fe, fw = font_checks(data.decode("utf-8", "replace"), active)
    errors += fe; warnings += fw

    # Approve-from-artifact is parked (Boss, 2026-10-26: mockup decisions are a question block, apart from Canvas
    # approvals), so a declared card that doesn't match only warns.
    warnings += card_checks(data.decode("utf-8", "replace"))
    srv = tempfile.mkdtemp(prefix="soma-look-")
    shutil.copy(path, os.path.join(srv, "page.html"))
    open(os.path.join(srv, "harness.html"), "w").write(HARNESS)
    reports = {}

    class H(http.server.SimpleHTTPRequestHandler):
        def __init__(s, *x, **k): super().__init__(*x, directory=srv, **k)
        def log_message(s, *x): pass
        def do_POST(s):
            k = re.search(r"k=(\w+)", s.path).group(1)
            reports[k] = json.loads(s.rfile.read(int(s.headers["content-length"])))
            s.send_response(204); s.end_headers()

    port = free_port()
    httpd = http.server.ThreadingHTTPServer(("127.0.0.1", port), H)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    # One hidden display and one Brave: two soma-look runs at once (say Phone B and C) shot each other's pages.
    # Take turns on a lock; the static checks above ran without it.
    import fcntl
    lock = open(os.path.join(CACHE, ".display.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("soma-look: another soma-look is using the hidden display; waiting for it", file=sys.stderr)
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        for size in [x.strip() for x in o.sizes.split(",") if x.strip()]:
            w, h = SIZES[size]; key = f"{size}{int(time.time() * 1000) % 100000}"
            r = run(["oma-phone", "--display", "bg", "url", f"http://127.0.0.1:{port}/harness.html?w={w}&h={h}&k={key}"])
            if '"ok": true' not in r.stdout and '"ok":true' not in r.stdout:
                print(f"soma-look: the hidden display didn't open ({size}): {(r.stdout + r.stderr).strip()[:300]}", file=sys.stderr)
                sys.exit(2)
            t0 = time.time()
            while key not in reports and time.time() - t0 < 30: time.sleep(0.3)
            rep = reports.get(key) or {"errors": [f"no report from the page at {size} within 30 s (did it crash?)"], "warnings": []}
            errors += [f"{size}: {e}" for e in rep.get("errors", [])]
            warnings += [f"{size}: {x}" for x in rep.get("warnings", [])]
            s = run(["oma-phone", "--display", "bg", "screenshot"])
            m = re.search(r'"path":\s*"([^"]+)"', s.stdout)
            if m:
                dst = os.path.join(out, f"{size}-{w}x{h}.png"); crop(m.group(1), dst); shots[size] = dst
    finally:
        httpd.shutdown(); shutil.rmtree(srv, ignore_errors=True); lock.close()

    receipt = {"file": path, "sha256": sha, "at": time.strftime("%Y-%m-%dT%H:%M:%S"), "sizes": SIZES,
               "pngs": shots, "errors": errors, "warnings": warnings, "ok": not errors}
    os.makedirs(CACHE, exist_ok=True)
    json.dump(receipt, open(os.path.join(CACHE, sha + ".json"), "w"), indent=1)
    for k, p in shots.items(): print(f"{k:9} {p}")
    for e in errors: print("ERROR  ", e)
    for x in warnings: print("warning", x)
    print(("looked: no errors" if not errors else f"looked: {len(errors)} error(s), fix before sending") +
          f"; {len(warnings)} warning(s). Now look at the PNGs yourself. Receipt {sha[:12]}.")
    sys.exit(0 if not errors else 1)


if __name__ == "__main__":
    main()
